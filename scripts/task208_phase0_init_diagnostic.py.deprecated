#!/usr/bin/env python3
"""
Task #208 Phase 0 — 双码本 init_emb 初始化诊断 (不训练).

流程:
  1. 用 baseline encoder (products/task181/hrqvae_fix_v2/Jul-25-2026_16-20-31/best_loss_model.pth)
     把 (9922, 768) item_emb.parquet 编码成 (9922, e_dim=32) latent.
  2. 把 latent 通过 L0 → L1 → L2 量化链, 收集每层进入 init_emb 的真实输入.
  3. 对目标层 (0/1/2), 用 HVectorQuantization 现有的双码本 init_emb 跑一次.
  4. 输出 4 项关键指标: cos_mean, cos_max, n_dup(cos>0.99), min‖residual‖.

通过标准:
  cos_max < 0.95
  n_dup = 0
  min ‖residual‖ > 1e-6     (若 ≤ 1e-6 → F.normalize 数值爆炸)

不通过 → 不进入 Phase 1.
"""
import os
import sys
import json
import argparse
import torch
import torch.nn.functional as F

# === R13: TRITON cache per task (防 sm_86 → sm_89 卡污染) ===
os.environ.setdefault("TRITON_CACHE_DIR", "/home/wlia0047/.triton/cache_task208")
os.makedirs(os.environ["TRITON_CACHE_DIR"], exist_ok=True)

HGREC_ROOT = "/fs04/ar57/wenyu/GeneRec/HG-Rec"
os.chdir(HGREC_ROOT)
sys.path.insert(0, HGREC_ROOT)

import numpy as np
import pandas as pd
from model.hrqvae import HRQVAE
from model.utils import kmeans


def load_baseline_encoder(ckpt_path, in_dim=768):
    model = HRQVAE(
        in_dim=in_dim,
        num_emb_list=[64, 128, 256],
        e_dim=32,
        layers=[512, 256, 128, 64],
        dropout_prob=0.0,
        bn=False,
        loss_type="poincare",
        kmeans_init=False,
        kmeans_iters=1000,
        sk_eps=[0.0, 0.0, 0.0],
        sk_iters=50,
        curvature_list=None,
    )
    sd = torch.load(ckpt_path, map_location="cpu", weights_only=False)
    enc_keys = [k for k in sd if k.startswith("encoder.")]
    dec_keys = [k for k in sd if k.startswith("decoder.")]
    missing, unexpected = model.load_state_dict(sd, strict=False)
    print(f"[load_baseline_encoder] loaded from {ckpt_path}")
    print(f"  encoder keys: {len(enc_keys)}, decoder keys: {len(dec_keys)}")
    print(f"  missing emb keys: {[k for k in missing if 'embeddings' in k or 'emb_geo' in k or 'emb_rec' in k][:5]} ...")
    return model


def encode_items(model, item_emb_path, batch_size=1024, device="cuda"):
    df = pd.read_parquet(item_emb_path)
    if "embedding" in df.columns:
        emb = np.stack(df["embedding"].values).astype(np.float32)
    else:
        emb = df.values.astype(np.float32)
    print(f"[encode_items] input shape {emb.shape}, dtype {emb.dtype}")
    model.eval()
    model.to(device)
    out = []
    with torch.no_grad():
        for i in range(0, len(emb), batch_size):
            x = torch.from_numpy(emb[i:i+batch_size]).to(device)
            z = model.encoder(x)
            out.append(z.cpu())
    latent = torch.cat(out, dim=0)
    print(f"[encode_items] latent shape {latent.shape}, "
          f"norm_p50={latent.norm(dim=-1).median().item():.4f}, "
          f"norm_min={latent.norm(dim=-1).min().item():.4e}, "
          f"norm_max={latent.norm(dim=-1).max().item():.4f}")
    return latent


def layer_init_diagnostic(vq, data, layer_idx, kmeans_iters=1000):
    data = data.to(vq.emb_geo.weight.device)
    # 模拟 trainer 在 init_emb 前已设好 z_mean buffer (用 batch 均值)
    if vq.dual_codebook and vq.use_centering:
        with torch.no_grad():
            mu = data.detach().mean(dim=0)
            vq.z_mean.copy_(mu)
        z_centered = data - mu.unsqueeze(0)
    else:
        z_centered = data

    dirs = F.normalize(z_centered, dim=-1, eps=1e-8)
    centers_geo = kmeans(dirs, vq.n_e, kmeans_iters).float().to(data.device)
    centers_geo = F.normalize(centers_geo, dim=-1, eps=1e-8)

    assign = (dirs @ centers_geo.t()).argmax(dim=-1)

    rec = torch.zeros_like(centers_geo)
    for k in range(vq.n_e):
        m = assign == k
        if m.any():
            rec[k] = z_centered[m].mean(0)
        else:
            idx = torch.randint(len(z_centered), (1,)).item()
            rec[k] = z_centered[idx]
    vq.emb_geo.weight.data.copy_(centers_geo)
    vq.emb_rec.weight.data.copy_(rec)
    vq.initted = True

    cos_matrix = dirs @ centers_geo.t()
    cos_per_item = cos_matrix.max(dim=-1).values
    cos_max = cos_per_item.max().item()
    cos_mean = cos_per_item.mean().item()
    n_dup = (cos_per_item > 0.99).sum().item()

    residual = z_centered - rec[assign]
    residual_norm = residual.norm(dim=-1)
    resid_norm_min = residual_norm.min().item()
    resid_norm_p50 = residual_norm.median().item()

    util_raw = (assign.bincount(minlength=vq.n_e) > 0).float().mean().item()
    hist_top5 = torch.bincount(assign, minlength=vq.n_e).topk(5).values.tolist()

    out = dict(
        layer=layer_idx,
        n_e=vq.n_e,
        cos_max=cos_max,
        cos_mean=cos_mean,
        n_dup=n_dup,
        resid_norm_min=resid_norm_min,
        resid_norm_p50=resid_norm_p50,
        util_raw=util_raw,
        assign_hist_top5=hist_top5,
    )
    print(f"\n[L{layer_idx} n_e={vq.n_e}] Phase 0 init_emb diagnostic:")
    for k, v in out.items():
        print(f"  {k}: {v}")
    return out


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--layer", type=int, required=True, help="0/1/2")
    parser.add_argument("--kmeans_iters", type=int, default=1000)
    parser.add_argument("--baseline_ckpt", type=str,
        default="/fs04/ar57/wenyu/GeneRec/products/task181/hrqvae_fix_v2/Jul-25-2026_16-20-31_beta_1.000_codebook_[64,128,256]_sk_0.000/best_loss_model.pth")
    parser.add_argument("--item_emb", type=str,
        default="/fs04/ar57/wenyu/GeneRec/HG-Rec/dataset/Instruments/item_emb.parquet")
    parser.add_argument("--device", type=str, default="cuda" if torch.cuda.is_available() else "cpu")
    parser.add_argument("--out_json", type=str, default=None)
    args = parser.parse_args()

    assert args.layer in (0, 1, 2), f"--layer must be 0/1/2, got {args.layer}"

    print(f"=== Task #208 Phase 0 — init_emb diagnostic, layer L{args.layer} ===")
    print(f"device={args.device}, kmeans_iters={args.kmeans_iters}")

    print("\n[Step 1] Construct HRQVAE + load baseline encoder")
    model = load_baseline_encoder(args.baseline_ckpt, in_dim=768)
    model.eval()
    model.to(args.device)

    print("\n[Step 2] Encode items via baseline encoder")
    latent = encode_items(model, args.item_emb, batch_size=1024, device=args.device)

    print("\n[Step 3] Build per-layer residual chain (走 vq_layers[i] 模拟层级)")
    cur_input = latent.to(args.device)
    per_layer_latent = []
    with torch.no_grad():
        for li in range(3):
            per_layer_latent.append(cur_input.cpu())
            vq = model.hrq.vq_layers[li]
            cur_input, _, _ = vq(cur_input, use_sk=True)
            cur_input = cur_input
    for li, lt in enumerate(per_layer_latent):
        print(f"  L{li} input norm median: {lt.norm(dim=-1).median().item():.4f}, "
              f"min: {lt.norm(dim=-1).min().item():.4e}")

    print(f"\n[Step 4] Init_emb + diagnostic for L{args.layer}")
    target_vq = model.hrq.vq_layers[args.layer]
    data_for_layer = per_layer_latent[args.layer]
    result = layer_init_diagnostic(target_vq, data_for_layer, args.layer, args.kmeans_iters)

    if args.out_json is None:
        args.out_json = f"/fs04/ar57/wenyu/GeneRec/verdicts/task208_phase0_init_l{args.layer}_diagnostic.json"
    os.makedirs(os.path.dirname(args.out_json), exist_ok=True)
    with open(args.out_json, "w") as f:
        json.dump(result, f, indent=2, ensure_ascii=False)
    print(f"\n[Done] result → {args.out_json}")

    print("\n=== 通过标准核验 ===")
    passes = []
    passes.append(("cos_max < 0.95", result["cos_max"] < 0.95))
    passes.append(("n_dup = 0", result["n_dup"] == 0))
    passes.append(("min ‖residual‖ > 1e-6", result["resid_norm_min"] > 1e-6))
    for name, ok in passes:
        marker = "✅" if ok else "❌"
        print(f"  {marker} {name}")
    overall = all(ok for _, ok in passes)
    print(f"\nPhase 0 整体判定: {'✅ PASS' if overall else '❌ FAIL'} — 不通过则不进入 Phase 1")


if __name__ == "__main__":
    main()
