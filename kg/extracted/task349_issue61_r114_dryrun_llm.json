        "id": "rootcause_hyp_c_sign_bug",
        "name": "hyp_c sign bug (sphere init instead of hyperbolic init)",
        "description": "HG_Rec_Issue57._init_sid_embedding_hyperbolic calls expmap0 with hyp_c=0.74 (positive), which triggers Euclidean branch x/(1+sqrt(1+c·‖x‖²)) — actually sphere init, not hyperbolic init. True hyperbolic requires hyp_c < 0 to trigger tanh branch."
      },
      {
        "id": "rootcause_euclidean_drift",
        "name": "AdamW Euclidean training drift out of Poincaré ball",
        "description": "T5 training with AdamW (Euclidean optimizer) causes SID token embeddings to drift out of Poincaré ball each step. Without Riemannian retraction, embeddings escape valid manifold region."
      },
      {
        "id": "rootcause_sphere_approx_random",
        "name": "sphere init ≈ random baseline",
        "description": "Per task482 verdict, sphere init (Euclidean branch with hyp_c=0.74) performs approximately equal to random baseline, so even with marginal gain from true hyperbolic, unlikely to break baseline."
      }
