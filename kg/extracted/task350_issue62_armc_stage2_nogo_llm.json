      {
        "id": "rootcause_layer0_radius_collapse",
        "name": "Small layer 0 radius + HypPre normalized inputs collapse",
        "description": "HypPre (expmap0 c=0.74) maps inputs to Poincaré ball, reducing input distribution variance; combined with layer 0 effective radius 0.2 (r=0.1, s=2), encoder produces smooth latents that all map to codeword 0."
      },
      {
        "id": "rootcause_three_way_joint_collapse",
        "name": "Sinkhorn ON + small L0 radius + HypPre three-way joint collapse",
        "description": "Combined effect: Sinkhorn forces uniform codebook usage during training, small L0 radius + HypPre normalized inputs compress latent space; at inference hard argmin collapses all residual_0 vectors to layer 0 codeword 0."
      }
