    "RootCause": [
      {
        "id": "rootcause_hyp_c_sign_bug_sphere_branch",
        "name": "hyp_c=0.74 sign bug forces sphere (Euclidean) branch",
        "description": "expmap0 formula routes c>=0 to Euclidean/sphere branch via x/(1+sqrt(1+c·||x||²)), so Task #159 intended as hyperbolic init actually runs as sphere init. Naming 'hyperbolic' is misleading."
      },
      {
        "id": "rootcause_stage2_sid_geometry_weak",
        "name": "Stage 2 SID geometric signal is weak — R10 RQ-VAE codebook μ=0.74",
        "description": "Stage 2 SID file _A2_t5_hrqvae_poincare.npy is generated by R10 RQ-VAE config (μ=0.74, expmap0 sphere branch). Stage 1 RQ-VAE freezes the SID geometry; sid_embedding_init has no leverage on already-frozen SID distribution."
      },
      {
        "id": "rootcause_init_strategy_no_leverage",
        "name": "sid_embedding_init has no architectural leverage under frozen Stage 2 SID",
        "description": "Init strategy only affects T5 token embedding initialization. It does not influence Stage 2 SID geometric distribution, T5 attention computation, or loss function. Under already-frozen SID config, init strategy is not an R@10 lever."
      }
    ],
