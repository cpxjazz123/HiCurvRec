# RQ-VAE Musical_Instruments config — 复用已训好的 rqvae_final.pt, 跳过重新训 RQ-VAE
# 跑 train_decoder.py 时也会 import 这部分 config, dataset/split 设置保持一致

import data.processed
import data.instruments  # 注册 RawMusicalInstruments

train.iterations = 400000
train.learning_rate = 0.001
train.weight_decay = 0.0001
train.batch_size = 640
train.vae_input_dim = 768
train.vae_n_cat_feats = 0
train.vae_hidden_dims = [512, 256, 128]
train.vae_embed_dim = 32
train.vae_codebook_size = 256
train.vae_codebook_normalize = False
train.vae_sim_vq = False
train.save_model_every = 5000
train.eval_every = 5000
train.dataset_folder = "dataset/"
train.dataset = %data.processed.RecDataset.INSTRUMENTS
train.save_dir_root = "out/rqvae/instruments/"
train.wandb_logging = False
train.commitment_weight = 0.25
train.vae_n_layers = 3
train.vae_codebook_mode = %modules.quantize.QuantizeForwardMode.STE
train.force_dataset_process = False
train.dataset_split = "instruments"
train.do_eval = True
train.use_kmeans_init = True
train.amp = True
train.mixed_precision_type = "fp16"
