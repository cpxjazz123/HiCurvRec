{
  "mechanism": "Issue #140 (M1): kappa_l = KAPPA_MAX tanh(theta_l) enters the level cost, the native residual and the readout",
  "calls": [
    {
      "name": "curved cost of one joint codeword inside one level",
      "callable": "model.learned_curvature:point_cost",
      "note": "The surface the curvature lives on: perturbing kappa changes the cost, and the cost is what the assignment is taken over.",
      "symbols": [
        "x0",
        "x1",
        "h0",
        "h1",
        "k0",
        "k1",
        "y0",
        "y1",
        "a",
        "c"
      ],
      "args": [
        {
          "name": "residual_e",
          "width": 2,
          "radius": 0.2,
          "sampler": "box"
        },
        {
          "name": "tangent_residual",
          "width": 2,
          "radius": 0.2,
          "sampler": "box"
        },
        {
          "name": "code_e",
          "width": 2,
          "radius": 0.2,
          "sampler": "box"
        },
        {
          "name": "code_t",
          "width": 2,
          "radius": 0.2,
          "sampler": "box"
        },
        {
          "name": "alpha",
          "scalar": 0.5
        },
        {
          "name": "kappa",
          "scalar": -1.0
        }
      ],
      "statements": [
        "bc = 1/sqrt(-c)",
        "ah = tanh(sqrt(-c)*sqrt(h0**2 + h1**2))/(sqrt(-c)*sqrt(h0**2 + h1**2) + 1e-12)",
        "b0 = ah*h0",
        "b1 = ah*h1",
        "ak = tanh(sqrt(-c)*sqrt(y0**2 + y1**2))/(sqrt(-c)*sqrt(y0**2 + y1**2) + 1e-12)",
        "d0 = ak*y0",
        "d1 = ak*y1",
        "xy = -(b0*d0 + b1*d1)",
        "hn = b0**2 + b1**2",
        "yn = d0**2 + d1**2",
        "negc = -c",
        "num0 = (1 + 2*negc*xy + negc*yn)*(-b0) + (1 - negc*hn)*d0",
        "num1 = (1 + 2*negc*xy + negc*yn)*(-b1) + (1 - negc*hn)*d1",
        "den = 1 + 2*negc*xy + negc**2*hn*yn + 1e-12",
        "mx0 = num0/den",
        "mx1 = num1/den",
        "mn = mx0**2 + mx1**2",
        "dist = 2/sqrt(negc)*atanh(Min(sqrt(negc)*sqrt(mn), 1 - 1e-6))",
        "euclidean = (x0 - k0)**2 + (x1 - k1)**2",
        "curved = dist**2",
        "cost = 2*(a*euclidean + (1 - a)*curved/4)"
      ],
      "output": "cost"
    }
  ],
