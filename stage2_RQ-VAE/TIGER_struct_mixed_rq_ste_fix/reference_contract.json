    "h1 = 1 + tanh(u1)",
    "h2 = 1 + tanh(u2)",
    "d01 = (p0 - p2) ** 2 + (p1 - p3) ** 2",
    "d02 = (p0 - p4) ** 2 + (p1 - p5) ** 2",
    "d12 = (p2 - p4) ** 2 + (p3 - p5) ** 2",
    "r01 = d01 / (s * s * h0 * h0)",
    "r02 = d02 / (s * s * h1 * h1)",
    "r12 = d12 / (s * s * h2 * h2)",
    "L = ((r01 - 1) ** 2 + (r02 - 1) ** 2 + (r12 - 1) ** 2) / 3"
   ],
   "output": "L",
   "domain": "||C_l^H|| <= 1; to_ball saturation shrink (1-1e-6) and log_0 clamp 1-1e-9 are the single declared strategy"
