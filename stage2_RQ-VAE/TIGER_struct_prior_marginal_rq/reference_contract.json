      ],
      "statements": [
        "xy = -(h0*y0 + h1*y1)",
        "hn = h0**2 + h1**2",
        "yn = y0**2 + y1**2",
        "num0 = (1 + 2*c*xy + c*yn)*(-h0) + (1 - c*hn)*y0",
