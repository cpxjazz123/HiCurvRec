        "mx0 = num0/den",
        "mx1 = num1/den",
        "mn = mx0**2 + mx1**2",
        "d = 2/sqrt(c)*atanh(Min(sqrt(c)*sqrt(mn), 1 - 1e-6))",
        "euclidean = (x0 - k0)**2 + (x1 - k1)**2",
        "curved = d**2",
        "cost = 2*(a*euclidean + (1 - a)*curved/4)"
      ],
      "output": "cost"
    }
