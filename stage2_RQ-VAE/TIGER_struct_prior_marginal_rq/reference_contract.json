      "callable": "model.mixed_rq:point_cost",
      "note": "unchanged from the baseline; alpha is the frozen table's 1/2",
      "symbols": [
        "x0",
        "x1",
        "h0",
        "h1",
        "k0",
        "k1",
        "y0",
        "y1",
        "a",
        "c"
      ],
      "args": [
        {
          "name": "residual_e",
          "width": 2,
          "radius": 0.2
        },
        {
          "name": "residual_h",
          "width": 2,
          "radius": 0.2
        },
        {
          "name": "code_e",
