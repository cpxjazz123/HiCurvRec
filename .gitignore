# === Project-specific exclusions (Task #117) ===

# Large binary dataset CSVs / tfrecords (regeneratable from upstream sources)
data/amazon_data/
data/*.csv
data/*.csv.gz
data/*.tfrecord
data/*.tfrecord.gz

# Run logs (transient, regeneratable from reruns)
logs/
# Iter audit logs + Stage3 results logs (CLAUDE §13; parent `logs/` must be re-included explicitly)
log_tensorboard/

# Training artifacts: model checkpoints, pickle files, etc.
products/

# Temporary task artifacts (diagnostic outputs, not deliverables)
task_artifacts/

# Process ID files (transient, regenerated on training start)
scripts/pids/

# Reference paper auxiliary files (transient or localized)
papers/notes/
papers/logs/
papers/grid_paper.txt

# Output results directory (regeneratable). Wholesale ignore is **not** used here
# because git's whitelist (`!pattern`) is shadowed by a parent directory ignore; instead
# we ignore by extension/path under results/ and never ignore a bare file.
# 大文件不推 (.pth / .parquet / *.npy inputs / *_launcher.log); 小产物需要推送.
results/**/*.pth
results/**/*.parquet
results/stage1_GeneEmbedding/*.npy
results/stage2_RQ-VAE/_input/*.npy
results/**/_stage3_launcher.log

# 显式覆盖 baseline 目录, 完整保留 logs / ckpt (含 .pth) 用于审计.
!results/stage2_RQ-VAE/TIGER_RQ-VAE/**
!results/stage3_T5Train/curvature_RQ-VAE_repaired/**
!results/stage3_T5Train/tiger/**
!results/stage3_T5Train/unknown_variant/**

