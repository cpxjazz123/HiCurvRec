# Decoder Musical_Instruments config — 用 rqvae_final.pt 作为 frozen RQ-VAE tokenizer

import data.processed
import data.instruments  # 注册 RawMusicalInstruments

# train.iterations 不再使用 (epoch-based 训练, MAX_EPOCHS=200 硬编码在 train_decoder.py)
train.learning_rate = 0.001
train.weight_decay = 0.0001
# DDP 4 卡: batch_size 是 per-global-batch, split_batches=True 让每卡各处理 2560/4=640
# (与单卡 baseline 一致), 通信开销被计算稀释
train.batch_size = 2560
train.vae_input_dim = 768
train.vae_hidden_dims = [512, 256, 128]
train.vae_embed_dim = 32
train.vae_n_cat_feats = 0
train.vae_codebook_size = 256
train.vae_n_layers = 3
train.wandb_logging = False
# 用已训好的 RQ-VAE (R47 路径约束) — M3 LearnableKappa
train.pretrained_rqvae_path = "/home/wlia0047/hj82_scratch2/wenyu/rqvae_dataset/instruments/rqvae_out_m3_learnable_kappa/rqvae_final.pt"
train.save_dir_root = "out/decoder/m3_learnable_kappa_instruments/"
train.dataset_folder = "dataset/"
train.dataset = %data.processed.RecDataset.INSTRUMENTS
train.force_dataset_process = False
train.full_eval_every = 500
# partial_eval 只算 eval loss (不跑 beam 生成), 不爆显存, 保留做 loss 曲线监控
train.partial_eval_every = 250
train.dataset_split = "instruments"
train.t5_d_model = 384
train.t5_num_heads = 6
train.t5_d_ff = 1024
train.t5_num_layers = 4
train.top_k_for_generation = 20
# HG-Rec 标准: best ckpt 由 valid NDCG@20 触发, 必须把 20 加入 eval list
train.top_k_eval_list = [1, 5, 10, 20]
train.should_add_sep_token = True
train.amp = True
train.mixed_precision_type = "fp16"
# === 双曲机制 M3: LearnableKappa (Euclidean_LearnableKappa 目录) ===
# Poincare 距离 + learnable κ (sigmoid clamp 到 [1e-4, 10.0]), RQ-VAE 训练时学最优曲率
# 注意: 当前 pretrained RQ-VAE 不含 learnable curvature param; train_rqvae_instruments.py 需同步开启
train.hyperbolic_mechanism = "learnable_kappa"
train.vae_init_curvature = 1.0
# quantize_distance_mode 走 Python 默认值 (QuantizeDistance.POINCARE); 不能用 gin % macro 传 Enum
