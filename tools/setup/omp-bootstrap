#!/bin/sh
# omp-bootstrap — the historical entry point, kept working.
#
# The state lives in oh-my-pi's own home directory $HOME/.omp (NFS), so there
# is no node-local installation to provision any more: `omp-local` hands out
# the canonical agent directory or a private slot, restores the configuration
# snapshot of a brand new installation and then runs omp.
#
# There is ONE configuration now, $HOME/.omp/agent: every instance reads it,
# and the namespace only names the private slot.
#
# The two verbs that operate on the shared configuration snapshot are kept:
#
# Usage:
#   omp-bootstrap <namespace> [omp args...]    run omp in that namespace
#   omp-bootstrap push|pull <profile> [--with-db]   snapshot handling
set -e

prof=${1:?usage: omp-bootstrap <profile> [omp args...]}
shift || true

case $prof in
  *[!A-Za-z0-9_-]*|'') echo "omp-bootstrap: bad profile name: $prof" >&2; exit 2 ;;
esac

if [ "${1:-}" = push ] || [ "${1:-}" = pull ]; then
  action=$1
  shift
  exec "$HOME/bin/omp-state" "$action" "$prof" "$@"
fi

exec "$HOME/bin/omp-local" "$prof" "$@"
