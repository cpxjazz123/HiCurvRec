#!/bin/sh
# omp-bootstrap — the historical entry point, kept working.
#
# The profile state lives in oh-my-pi's own home directory $HOME/.omp (NFS),
# so there is no node-local installation to provision any more: `omp-local`
# picks the agent directory of the profile, hands out a private slot when the
# profile is already busy, restores the configuration snapshot of a brand new
# profile and then runs omp.
#
# The two verbs that operate on the shared configuration snapshot are kept:
#
# Usage:
#   omp-bootstrap <profile> [omp args...]      run omp on that profile
#   omp-bootstrap push|pull <profile> [--with-db]   snapshot handling
set -e

prof=${1:?usage: omp-bootstrap <profile> [omp args...]}
shift || true

case $prof in
  *[!A-Za-z0-9_-]*|'') echo "omp-bootstrap: bad profile name: $prof" >&2; exit 2 ;;
esac

if [ "${1:-}" = push ] || [ "${1:-}" = pull ]; then
  action=$1
  shift
  exec "$HOME/bin/omp-state" "$action" "$prof" "$@"
fi

exec "$HOME/bin/omp-local" "$prof" "$@"
