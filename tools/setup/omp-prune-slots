#!/bin/sh
# omp-prune-slots — remove the private slots that nobody is using.
#
# A slot is a private agent directory of one omp instance.  Its owner holds a
# flock on <slot>/.locks/<slot>.lock for as long as it lives, so the lock is
# the liveness test: whoever can take the lock owns nobody's data.
#
# The slots of an older layout carry databases written by an older omp
# version.  When omp opens such a database and cannot make sense of it, it
# renames it to ".corrupt-<timestamp>-<uuid>" -- and a rename unlinks the
# file, which invalidates the mapping the process itself holds and kills it
# with SIGBUS ("Bus error at address ...", exit 135).  Removing the idle slots
# removes those databases with them.
#
# A slot whose lock is held is left alone: its instance is alive.
#
# Usage:  omp-prune-slots

set -e

: "${HOME:?omp-prune-slots: HOME is not set}"

omp_home=$HOME/.omp
slots=$omp_home/omp-slots
[ -d "$slots" ] || exit 0

removed=0
kept=0

for nsdir in "$slots"/*; do
  [ -d "$nsdir" ] || continue
  ns=${nsdir##*/}
  case $ns in .*) continue ;; esac
  locks=$nsdir/.locks
  [ -d "$locks" ] || continue
  for slotdir in "$nsdir"/*; do
    [ -d "$slotdir" ] || continue
    name=${slotdir##*/}
    case $name in .*) continue ;; esac
    lockf=$locks/$name.lock
    [ -e "$lockf" ] || touch "$lockf"
    # The lock is taken in a subshell: the shell exits right away and the lock
    # is released again, but taking it proved that nobody owns the slot.
    if ( exec 9<>"$lockf"; flock -n 9 ) 2>/dev/null; then
      rm -rf "$slotdir"
      rm -f "$lockf"
      removed=$((removed + 1))
      echo "removed idle slot $slotdir"
    else
      kept=$((kept + 1))
      echo "kept live slot $slotdir"
    fi
  done
done

echo "removed $removed idle slots, kept $kept live slots"
