#!/bin/sh
# omp-login — 登录 / 重新登录模型提供商。
#
# 凭据的唯一真源是 $HOME/.omp/credentials/agent/agent.db。每个并发实例在创建
# 时从那里拿一份自己的副本（绝不能共享同一个 SQLite 文件：两个进程打开同一个
# 数据库正是 Bus error 的成因）。所以登录必须发生在这个专门的目录里，登录
# 之后跑一次 omp-credentials 把新凭据发给各个实例。
#
# 用法:  omp-login [传给 omp login 的参数...]
set -e

export PI_CONFIG_DIR=".omp/credentials"
unset XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
unset OMP_PROFILE PI_PROFILE

exec "$HOME/.local/bin/omp" login "$@"
