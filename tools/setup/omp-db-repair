#!/bin/sh
# omp-db-repair -- check and repair the SQLite databases of oh-my-pi.
#
# A database that oh-my-pi cannot read is renamed to ".corrupt-<timestamp>-
# <uuid>" and rebuilt.  The rename unlinks the file under the mapping of the
# running process, so omp dies with SIGBUS ("Bus error at address 0x7F...",
# exit 135) instead of starting -- and the corrupt file stays where it is,
# because the rename kills the process before it can move the file aside.  The
# next start finds the same corrupt file and dies the same way.  A malformed
# database in the agent directory therefore takes down every instance.
#
# This script repairs that state:
#
#   check    report the health of every database under $HOME/.omp
#   repair   rebuild the unreadable ones (sqlite's own salvage keeps the
#            schema, the credentials and the usage tables), fold the
#            write-ahead logs into the databases and drop the stale
#            shared-memory files
#
# The repair needs a quiet system: it refuses to run while an omp instance is
# alive, because writing a database that a live instance has mapped is
# exactly what causes the crash in the first place.
#
# Usage:  omp-db-repair [check|repair]
set -e

action=${1:-check}
case $action in
  check|repair) ;;
  *) echo "usage: omp-db-repair [check|repair]" >&2; exit 2 ;;
esac

HERE=$(cd "$(dirname "$0")" && pwd)
DBTOOL=$HERE/omp-dbtool.py
if [ ! -f "$DBTOOL" ]; then
  echo "omp-db-repair: missing the database helper $DBTOOL" >&2
  exit 8
fi

omp_home=$HOME/.omp
canonical=$omp_home/agent
creds=$omp_home/credentials/agent
pool=$omp_home/instances

# Every database of the credential source, of the canonical agent directory and
# of the instances.
list_dbs() {
  for db in "$creds"/*.db "$canonical"/*.db "$pool"/inst-*/agent/*.db; do
    if [ -f "$db" ]; then echo "$db"; fi
  done
  return 0
}

# The repair writes databases, so no instance may hold one open.  Every
# instance holds one slot lock for as long as it runs; a lock that cannot be
# taken belongs to a live instance.
require_quiet() {
  mkdir -p "$pool" "$canonical"
  for l in "$pool"/slot-*.lock; do
    [ -e "$l" ] || continue
    exec 9<>"$l"
    if ! flock -n 9; then
      echo "omp-db-repair: an omp instance holds $l" >&2
      echo "omp-db-repair: stop every omp instance and run this again" >&2
      exit 4
    fi
    exec 9>&-
  done
}

report() {  # report <db> -> prints the verdict, returns 0 when it is readable
  verdict=$(python3 "$DBTOOL" check "$1" 2>&1) || true
  [ -n "$verdict" ] || verdict="corrupt: the check failed"
  case $verdict in
    ok)      echo "  ok      $1" ;;
    missing) echo "  missing $1" ;;
    *)       echo "  BROKEN  $1  ($verdict)" ;;
  esac
  case $verdict in
    ok|missing) return 0 ;;
    *) return 1 ;;
  esac
}

if [ "$action" = "check" ]; then
  echo "== oh-my-pi 数据库健康检查（$omp_home）=="
  broken=0
  for db in $(list_dbs); do
    report "$db" || broken=1
  done
  if [ "$broken" = 0 ]; then
    echo "所有数据库都可读"
  else
    echo "有数据库不可读：用 'omp-db-repair repair' 修复" >&2
    exit 1
  fi
  exit 0
fi

# --- repair ----------------------------------------------------------------
require_quiet

archive=$omp_home/legacy-db-$(date +%Y%m%d-%H%M%S)
mkdir -p "$archive"

echo "== 修复 oh-my-pi 数据库（$omp_home）=="
for db in $(list_dbs); do
  if report "$db"; then
    # A readable database still carries a write-ahead log of the crash that
    # left it behind; folding it in and dropping the stale shared-memory
    # file keeps the next start from having to recover it.
    python3 "$DBTOOL" checkpoint "$db" >/dev/null ||
      { echo "omp-db-repair: cannot fold the write-ahead log of $db" >&2; exit 5; }
    continue
  fi

  echo "-- 重建 $db"
  rebuilt=$db.rebuilt
  rm -f "$rebuilt"
  python3 "$DBTOOL" recover "$db" "$rebuilt" ||
    { echo "omp-db-repair: cannot rebuild $db" >&2; exit 5; }
  if ! python3 "$DBTOOL" check "$rebuilt" >/dev/null 2>&1; then
    rm -f "$rebuilt"
    echo "omp-db-repair: the rebuilt $db is still not readable" >&2
    exit 5
  fi
  # The credentials are what makes an instance usable; a rebuild that lost
  # them is not put in place.
  if [ "$db" = "$creds/agent.db" ]; then
    creds=$(python3 "$DBTOOL" credcount "$rebuilt")
    if [ "$creds" -lt 1 ] 2>/dev/null; then
      rm -f "$rebuilt"
      echo "omp-db-repair: the rebuild of $db lost the credentials; nothing was changed" >&2
      exit 5
    fi
    echo "   凭据保留 $creds 条"
  fi
  mv "$db" "$archive/$(basename "$db").corrupt"
  mv "$rebuilt" "$db"
  rm -f "$db-wal" "$db-shm"
  echo "   已换入重建后的数据库"
done

echo
echo "== 复查 =="
broken=0
for db in $(list_dbs); do
  report "$db" || broken=1
done
if [ "$broken" = 0 ]; then
  echo "所有数据库都可读"
  if [ -d "$archive" ]; then
    echo "损坏的原件留在 $archive"
  fi
  exit 0
fi
echo "仍有数据库不可读" >&2
exit 1
