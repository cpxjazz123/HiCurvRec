#!/bin/sh
# omp-local — run oh-my-pi with its state in the home directory (NFS).
#
# Everything a node needs lives in $HOME, which is shared by every node of the
# cluster (172.23.236.2:/m3-home).  There is no node-local installation step:
# `omp` works the same on every node, and a profile's state, sessions and
# configuration are the same everywhere.
#
# Layout:
#   $HOME/omp_local_<profile>/agent/             canonical agent dir (first instance)
#   $HOME/omp_local_<profile>/agents/<slot>/     private agent dir (extra instances)
#   $HOME/omp_local_<profile>/agents/.locks/     ownership locks of the slots
#   $HOME/omp_local_<profile>/plugins -> shared plugin store
#   $HOME/omp_local_<profile>/logs/
#   $HOME/omp_local_<profile>/.lock              role lock of the canonical dir
#
# Concurrency (2026-11-15): ANY number of instances may run at once on the same
# profile, on this node or on any other.  Two rules keep them from stepping on
# each other:
#
#   1. No two live processes ever open the same SQLite file.  The first instance
#      of a profile owns the canonical agent dir and holds .lock; every further
#      instance transparently gets a private slot with its own agent.db /
#      history.db / models.db / sessions / cache.
#   2. What is meant to be shared stays shared, by symlink into the slot:
#      config.yml, settings.json, auth.json, models-store.json, keybindings.json
#      and the rooms directory.  The plugin store and the logs live under the
#      profile root, so they are shared by construction.
#
# Ownership is expressed with flock(2), which the NFS server arbitrates
# across nodes (mount option local_lock=none).  A lock is therefore held for
# exactly as long as its owner lives: when an instance exits -- or when its node
# dies -- the server releases the lock and the slot becomes reusable.  There is
# no owner file to go stale and no cross-node liveness guess to make.  The lock
# files live in agents/.locks/, NOT inside the agent dir, because omp owns that
# directory and may clean unknown files out of it.
#
# The lock is a ROLE SELECTOR, not a barrier: it never refuses a start.  Set
# OMP_LOCAL_STRICT=1 to restore the old fail-closed behaviour (exit 3).
#
# Note: the SQLite databases live on NFS.  SQLite mmaps the "-shm" file, so if
# that file is truncated or replaced under the mapping the kernel raises SIGBUS
# and omp dies with "Bus error at address ..." (exit 135).  The slot isolation
# above keeps two writers away from one database; the remaining exposure is a
# foreign process truncating the same file.
#
# Usage:  omp-local <profile> [omp args...]

set -e

prof=${1:?usage: omp-local <profile> [omp args...]}
shift || true

case $prof in
  *[!A-Za-z0-9_-]*|'') echo "omp-local: bad profile name: $prof" >&2; exit 2 ;;
esac

: "${HOME:?omp-local: HOME is not set}"

# PI_CONFIG_DIR is a dirname under $HOME, so the profile root lives there too.
root=$HOME/omp_local_$prof
agent=$root/agent
slots=$root/agents
slotlocks=$slots/.locks

# Shared, node-independent stores (not node-local, so no per-node install).
PLUGIN_STORE=${OMP_PLUGIN_STORE:-/fs04/ar57/wenyu/omp_plugins}
ROOM_STORE=${OMP_ROOM_STORE:-/fs04/ar57/wenyu/omp_rooms}
SNAPSHOT_STORE=${OMP_SNAPSHOT_STORE:-/fs04/ar57/wenyu/omp_state}

# Shared between the canonical agent dir and every slot: the configuration, the
# credentials, the package list and the rooms.  Copied into a slot as symlinks,
# so all instances read and write one copy.
SHARED_FILES="config.yml settings.json auth.json models-store.json keybindings.json"
SHARED_DIRS="rooms"

mypid=$$
myhost=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)

mkdir -p "$agent" "$slots" "$slotlocks" "$root/logs"

# The plugin store and the rooms are node-independent; link them in once.
for d in "$PLUGIN_STORE/$prof" "$ROOM_STORE"; do
  [ -d "$d" ] && continue
  mkdir -p "$d" || { echo "omp-local: cannot create the shared store $d" >&2; exit 2; }
done
if [ ! -L "$root/plugins" ]; then
  if [ -e "$root/plugins" ]; then
    rm -rf "$root/plugins"
  fi
  ln -s "$PLUGIN_STORE/$prof" "$root/plugins"
fi
if [ ! -L "$agent/rooms" ]; then
  if [ -e "$agent/rooms" ]; then
    rm -rf "$agent/rooms"
  fi
  ln -s "$ROOM_STORE" "$agent/rooms"
fi

# A brand new profile gets its configuration from the shared snapshot.  Having
# no snapshot yet is the normal case for a new profile; a snapshot that exists
# but cannot be restored is a real failure and must not be papered over.
if [ ! -f "$agent/config.yml" ] && [ -d "$SNAPSHOT_STORE/$prof/agent" ]; then
  "$HOME/bin/omp-state" restore "$prof" ||
    { echo "omp-local: cannot restore the configuration snapshot of profile '$prof'" >&2; exit 4; }
fi

claim_slot() {  # claim_slot <slotname> -> 0 when this process owns the slot
  lockf=$slotlocks/$1.lock
  [ -e "$lockf" ] || touch "$lockf"
  exec 8<>"$lockf"
  flock -n 8
}

pick_slot() {  # pick_slot -> sets $chosen to the slot this instance may use
  for d in "$slots"/*; do
    [ -d "$d" ] || continue
    name=${d##*/}
    case $name in .*) continue ;; esac
    if claim_slot "$name"; then
      chosen=$d
      return 0
    fi
    exec 8>&-   # the slot is taken by a live instance; try the next one
  done
  # Nothing reusable: mint a new one.  The name carries the host and the pid,
  # so two nodes -- or two processes -- can never mint the same name.
  n=1
  while [ -e "$slots/$myhost-$mypid-$n" ]; do n=$((n + 1)); done
  name="$myhost-$mypid-$n"
  mkdir -p "$slots/$name"
  if claim_slot "$name"; then
    chosen=$slots/$name
    return 0
  fi
  echo "omp-local: cannot claim the new slot $name" >&2
  exit 5
}

seed_slot() {  # seed_slot <slotdir> -> link the shared config into the slot
  slot=$1
  mkdir -p "$slot"
  for f in $SHARED_FILES; do
    src=$agent/$f
    [ -e "$src" ] || continue
    dst=$slot/$f
    if [ -L "$dst" ]; then
      if [ "$(readlink "$dst")" = "$src" ]; then continue; fi
      rm -f "$dst"
    elif [ -e "$dst" ]; then
      continue   # a real file in the slot wins (a local edit)
    fi
    ln -s "$src" "$dst"
  done
  for d in $SHARED_DIRS; do
    src=$agent/$d
    [ -e "$src" ] || continue
    dst=$slot/$d
    if [ -L "$dst" ]; then
      if [ "$(readlink "$dst")" = "$src" ]; then continue; fi
      rm -f "$dst"
    elif [ -e "$dst" ]; then
      continue
    fi
    ln -s "$src" "$dst"
  done
}

# --- role selection --------------------------------------------------------
# fd 9 carries the lock through exec, so it is held for the whole life of the
# omp process.  Winning the lock makes this instance the primary; losing it
# only means "somebody else is primary", which is not an error.
#
# The lock file is opened read-write WITHOUT O_TRUNC and WITHOUT O_APPEND, and
# that detail is load-bearing: over NFS a contender that opens the file with
# O_TRUNC or O_APPEND does not conflict with the lock the holder already has,
# so both nodes would believe they own the profile and would write the same
# SQLite files.  Measured on this cluster: O_RDWR excludes correctly across
# nodes, O_WRONLY/O_TRUNC/O_APPEND does not.
touch "$root/.lock"
exec 9<>"$root/.lock"
if flock -n 9; then
  agent_dir=$agent
  role=primary
else
  if [ "${OMP_LOCAL_STRICT:-0}" = "1" ]; then
    echo "omp-local: profile '$prof' is already in use by another omp process" >&2
    exit 3
  fi
  # NOT in a command substitution: the slot lock must stay open in this shell
  # so that it survives the exec below.
  pick_slot
  agent_dir=$chosen
  role=slot
fi

if [ "$role" = "slot" ]; then
  seed_slot "$agent_dir"
  echo "omp-local: profile '$prof' is busy -> private slot '${agent_dir##*/}'" >&2
fi
mkdir -p "$agent_dir"

# --- the binary ------------------------------------------------------------
bin=${OMP_BINARY:-$HOME/.local/bin/omp}
if [ ! -x "$bin" ]; then
  echo "omp-local: no omp binary at $bin" >&2
  exit 2
fi

export PI_CONFIG_DIR=omp_local_$prof
# An inherited PI_CODING_AGENT_DIR (e.g. from an `omp-b` alias) outranks the
# config root and silently puts the SQLite files in the wrong place.
export PI_CODING_AGENT_DIR="$agent_dir"
unset PI_CODING_AGENT_SESSION_DIR PI_SESSION_FILE PI_SESSION_ID PI_TOOL_CALL_ID
exec "$bin" "$@"
