#!/bin/sh
# omp-credentials — 把凭据真源同步到各个实例。
#
# 背景：每个并发实例有自己的 agent 目录，agent.db 也就各有一份（两个进程打开
# 同一个 SQLite 文件正是 Bus error 的成因）。槽位第一次创建时会从真源装一份
# 凭据副本，之后该实例自己续期。
#
# OAuth 的 refresh token 会被 provider 轮换：某一台机器刷新之后，别的副本就
# 失效了。所以在 omp-login 重新登录之后，要跑一次这个命令，把新的凭据发到
# 每个实例。API key 凭据不会轮换，不需要这一步。
#
# 覆盖一个正在被实例打开的数据库会让那个实例的映射失效（SIGBUS），所以正在
# 运行的实例会被跳过（它的槽位锁被持有）。要给它也换上，跑完这个命令之后
# 重启那个实例。
#
# 用法:  omp-credentials
set -e

HERE=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)
DBTOOL="$HERE/omp-dbtool.py"
[ -f "$DBTOOL" ] || DBTOOL="$HOME/.omp/bin/omp-dbtool.py"

omp_home=$HOME/.omp
src="$omp_home/credentials/agent/agent.db"
pool="$omp_home/instances"

if [ ! -f "$DBTOOL" ]; then
  echo "omp-credentials: 找不到数据库备份工具 $DBTOOL" >&2
  exit 8
fi
if [ ! -f "$src" ]; then
  echo "omp-credentials: 找不到凭据真源 $src（先跑 omp-login 登录）" >&2
  exit 5
fi

creds=$(python3 "$DBTOOL" credcount "$src")
if [ "$creds" -lt 1 ] 2>/dev/null; then
  echo "omp-credentials: 凭据真源里没有凭据：$src" >&2
  exit 5
fi
echo "凭据真源: $src（$creds 条）"

n=0
skipped=0
for inst in "$pool"/inst-*; do
  [ -d "$inst/agent" ] || continue
  # 这个实例正在运行吗？它的槽位锁被持有就说明还在跑，不能覆盖它的数据库。
  slot=${inst##*/inst-}
  lock="$pool/slot-$slot.lock"
  running=no
  if [ -e "$lock" ]; then
    exec 9<>"$lock"
    if ! flock -n 9; then running=yes; fi
    exec 9>&-
  fi
  if [ "$running" = yes ]; then
    echo "  跳过 $(basename "$inst")（正在运行，重启它才会换上新凭据）"
    skipped=$((skipped + 1))
    continue
  fi
  python3 "$DBTOOL" snapshot "$src" "$inst/agent/agent.db" >&2 ||
    { echo "omp-credentials: 无法同步 $inst/agent/agent.db" >&2; exit 5; }
  got=$(python3 "$DBTOOL" credcount "$inst/agent/agent.db")
  if [ "$got" -lt 1 ] 2>/dev/null; then
    echo "omp-credentials: 同步后 $inst 里仍然没有凭据" >&2
    exit 5
  fi
  echo "  已同步 $(basename "$inst")（$got 条凭据）"
  n=$((n + 1))
done

echo "完成：同步 $n 个实例，跳过 $skipped 个正在运行的实例"
