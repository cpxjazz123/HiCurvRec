#!/bin/sh
# omp — 并发隔离入口。
#
# 官方二进制装在 $HOME/.local/bin/omp，omp 的自更新会原地替换那个文件，
# 所以 wrapper 不能占用那个路径；本 wrapper 装在 ~/bin/omp，而 ~/bin 在 PATH 上
# 排在 ~/.local/bin 前面。
#
# 这个 wrapper 只做一件事：让每个并发实例有自己的配置根，从而让 SQLite 数据库不共享。
#
# 为什么必须隔离（2026-11-16 在本机实测）
# --------------------------------------
# 官方原样安装时，4 个实例并发跑 `omp models` 全部 Bus error (core dumped)（退出码 135），
# 而 4 个实例并发跑只读的 `omp auth export` 全部正常。机制是 SQLite 的 WAL 模式：
# 多个进程打开同一个数据库文件时，后来的进程会重建 <db>-shm，前面那个进程映射的
# 共享内存随之失效，进程立刻 SIGBUS。这个家目录在 NFS 上，跨节点同样成立，
# 而且没有任何应用层错误信息。
#
# 隔离的办法：给每个实例一个私有的配置根（PI_CONFIG_DIR）。配置根一变，agent 目录、
# data/state/cache 三个根全都跟着变，数据库也就各写各的。
#
#   PI_CONFIG_DIR 必须相对 $HOME：omp 用 path.join(HOME, PI_CONFIG_DIR) 拼路径，
#   path.join 不会把带前导斜杠的第二个参数当成绝对路径。
#   XDG_DATA_HOME / XDG_STATE_HOME / XDG_CACHE_HOME 必须 unset：这些环境变量存在时，
#   omp 会优先用它们，四个根又会被拉回共享位置。
#
# 配置本身仍然只有一份：$HOME/.omp/agent/ 里的文件被软链进每个实例。
# 插件与原生组件是只读的大件，所有实例共用一份。
set -e

REAL="$HOME/.local/bin/omp"
POOL="$HOME/.omp/instances"
MAX_SLOTS=64

HERE=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)
DBTOOL="$HERE/omp-dbtool.py"
[ -f "$DBTOOL" ] || DBTOOL="$HOME/.omp/bin/omp-dbtool.py"

mkdir -p "$POOL"

# 槽位分配：flock 是唯一能跨节点仲裁的机制（NFS 上 fcntl 锁不可靠）。
# 锁文件必须以 O_RDWR 打开，不能带 O_TRUNC/O_APPEND：那样打开的竞争方不与
# 持有方的锁冲突，两个节点会同时自认为主。
slot=""
i=0
while [ "$i" -lt "$MAX_SLOTS" ]; do
  exec 9<>"$POOL/slot-$i.lock"
  if flock -n 9; then
    slot=$i
    break
  fi
  exec 9>&-
  i=$((i + 1))
done
if [ -z "$slot" ]; then
  echo "omp: $MAX_SLOTS 个实例槽位都被占用了" >&2
  exit 3
fi
# fd 9 在下面 exec 之后仍由 omp 继承，锁一直保持到 omp 退出，槽位不会被别人抢走。

canon="$HOME/.omp/agent"
creds_src="$HOME/.omp/credentials/agent/agent.db"

root="$POOL/inst-$slot"
mkdir -p "$root/agent"

# 配置只有一份：$HOME/.omp/agent/ 里的文件被软链进每个实例。
# 会话历史与 blob 也软链过去，这样新实例能看到全部旧会话（session id 唯一，
# 两个实例写同一个会话文件只在同时 resume 同一个会话时才会发生）。
for f in config.yml config.deepseek.yml settings.json auth.json \
         models-store.json keybindings.json marketplaces.json; do
  if [ -e "$canon/$f" ]; then ln -sfn "$canon/$f" "$root/agent/$f"; fi
done
for d in agents rooms sessions blobs; do
  if [ -e "$canon/$d" ]; then ln -sfn "$canon/$d" "$root/agent/$d"; fi
done
# 插件与原生组件是只读的大件，所有实例共用一份。
for d in plugins natives; do
  if [ -e "$HOME/.omp/$d" ]; then ln -sfn "$HOME/.omp/$d" "$root/$d"; fi
done
if [ -e "$HOME/.omp/install-id" ]; then
  ln -sfn "$HOME/.omp/install-id" "$root/install-id"
fi

# 凭据：唯一真源是 $HOME/.omp/credentials/agent.db（用 omp-login 在那里登录）。
# 槽位第一次使用时给它装一份自己的副本，之后该实例自己续期，互不影响。
# 绝不能把 agent.db 软链过去：两个进程打开同一个 SQLite 文件正是 Bus error 的成因。
# 复制用的是 sqlite 的热备份接口（先把主库和 WAL 一起拷到临时目录再导出），
# 所以真源正在被写入时也不会拷到撕裂的副本。
if [ ! -f "$root/agent/agent.db" ]; then
  if [ -f "$creds_src" ]; then
    if [ ! -f "$DBTOOL" ]; then
      echo "omp: 找不到数据库备份工具 $DBTOOL" >&2
      exit 4
    fi
    python3 "$DBTOOL" snapshot "$creds_src" "$root/agent/agent.db" >&2 ||
      { echo "omp: 无法把凭据复制到实例目录 $root/agent/agent.db" >&2; exit 4; }
    creds=$(python3 "$DBTOOL" credcount "$root/agent/agent.db")
    if [ "$creds" -lt 1 ] 2>/dev/null; then
      echo "omp: 复制过来的实例数据库里没有凭据（$root/agent/agent.db）" >&2
      exit 4
    fi
  fi
fi

export PI_CONFIG_DIR=".omp/instances/inst-$slot"

unset XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME
unset OMP_PROFILE PI_PROFILE

exec "$REAL" "$@"
