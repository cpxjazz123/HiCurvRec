  ],
  "mechanism": {
    "coefficient_policy": "the mechanism enters the host's loss with weight 0.05; the relational term enters the per-pair term with weight 0.1; the margin is 0.5 L1 units",
    "directionality": "directed: the source is the anchor and the target is what must be closer to its own nearest codebook entry; the two roles are not interchangeable",
    "id": "masked_directed_codebook_margin",
    "masking": "a pair is valid when its source and its target are different items; the loss is the masked mean over the valid pairs and the denominator is their count",
    "normalization": "distances are L1 sums over the latent dimension; the assignment is a softmax over the codebook entries with temperature 0.1; no other normalisation is applied",
    "permitted_approximations": [
      "the argmin is computed in the ambient dtype; a tie is broken by the lowest index"
    ],
    "summary": "For every valid (source, target) pair, penalise the target's nearest codebook entry being farther from the target than the source's nearest entry is from the source, and add a relational term that measures how far apart the two codebook assignments sit through the codebook's own pairwise geometry.",
    "version": "1.0.0"
  },
  "objective": {
    "equation": "A[b,c] = ||z_src[b] - E[c]||_1 ; B[b,c] = ||z_tgt[b] - E[c]||_1 ; c*_src = argmin_c A[b,c] ; c*_tgt = argmin_c B[b,c] ; r[b] = max(0, margin + B[b,c*_tgt] - A[b,c*_src]) ; p[b] = softmax_c(-A[b,c]/temperature) ; q[b] = softmax_c(-B[b,c]/temperature) ; G[i,j] = ||E[i] - E[j]||_1 ; s[b] = sum_{i,j} p[b,i] q[b,j] G[i,j] ; L = sum_b mask[b] (r[b] + structural_weight * s[b]) / sum_b mask[b]",
    "parameters": {
      "margin": 0.5,
      "structural_weight": 0.1,
      "temperature": 0.1
    },
    "reference_implementation": "tools/mvg/reference/directed_codebook_margin.py",
    "reference_symbols": {
      "finite_difference_gradient": "finite_difference_gradient(loss_fn, tensors, step)",
      "intermediates": "reference_intermediates(z_src, z_tgt, codebook, mask)",
      "loss": "reference_loss(z_src, z_tgt, codebook, mask)"
    },
    "symbols": {
      "E": "level-0 codebook entries, [C, D]",
      "mask": "1 for a valid pair, 0 for an invalid one, [B]",
      "z_src": "source residual of the pair, [B, D]",
      "z_tgt": "target residual of the pair, [B, D]"
    }
  },
