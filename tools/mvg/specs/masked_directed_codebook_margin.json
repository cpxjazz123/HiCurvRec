  "forbidden_substitutions": [
    {
      "id": "no_detached_path",
      "pattern": "\\.detach\\s*\\(",
      "why": "the specification declares nonzero gradient targets on the source residual, the target residual and the codebook; a detach anywhere in the mechanism silently cuts one of them off"
    },
    {
      "id": "no_distance_mse_substitution",
      "pattern": "mse_loss|MSELoss",
      "why": "the relational term is a discrepancy between two codebook assignments measured through the codebook's own geometry; a per-element mean squared error on the distances is a different quantity that happens to be computable"
    },
    {
      "id": "no_symmetric_averaging",
      "pattern": "(?s)0\\.5\\s*\\*\\s*\\(.{0,200}?\\+.{0,200}?\\)",
      "why": "the mechanism is directed: the source and the target play different roles, and averaging the two directions would make it a similarity rather than a transition"
    },
    {
      "id": "no_batch_size_denominator",
      "pattern": "/\\s*(?:z_src\\.shape\\[0\\]|batch_size)\\b",
      "why": "the denominator of the masked mean is the number of VALID pairs, not the batch size; dividing by the batch size would silently rescale the term whenever a pair is masked out"
    }
  ],
