  "invariants": [
    {
      "id": "direction_matters",
      "kind": "metamorphic",
      "statement": "swapping the source and the target changes the loss: the mechanism is a directed transition, not a similarity"
    },
    {
      "id": "codebook_permutation_equivariant",
      "kind": "metamorphic",
      "statement": "permuting the codebook rows leaves the loss unchanged: the relational term sums over all pairs of entries and the assignment is a softmax over the same set"
    },
    {
      "id": "pair_permutation_invariant",
      "kind": "metamorphic",
      "statement": "permuting the pairs leaves the masked mean unchanged"
    },
    {
      "id": "masked_pair_contributes_nothing",
      "kind": "numeric",
      "statement": "a pair whose mask entry is zero contributes nothing to the loss, and the denominator counts only the valid pairs"
    },
    {
      "id": "finite_on_ties_and_degeneracy",
      "kind": "numeric",
      "statement": "the loss is finite when two codebook entries are equidistant, when the codebook has identical rows, and when every pair is masked out"
    },
    {
      "id": "reaches_three_gradient_targets",
      "kind": "structural",
      "statement": "the mechanism's gradient reaches the source residual, the target residual and the codebook"
    }
  ],
