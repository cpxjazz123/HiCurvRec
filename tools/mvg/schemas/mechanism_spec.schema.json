{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cpxjazz123/HiCurvRec/tools/mvg/schemas/mechanism_spec.schema.json",
  "title": "MechanismSpec",
  "description": "A frozen, reviewable declaration of one Stage-2 mechanism: its exact objective, its invariants, the substitutions it forbids, the synthetic cases that decide whether an implementation is faithful, and the contract the CGV checks. Authored and reviewed before the implementation exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mechanism",
    "integration",
    "objective",
    "gradient_targets",
    "forbidden_substitutions",
    "invariants",
    "cases",
    "tolerances",
    "cgv_contract",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "summary", "directionality", "masking", "normalization", "coefficient_policy", "permitted_approximations"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "version": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "directionality": { "type": "string", "minLength": 1 },
        "masking": { "type": "string", "minLength": 1 },
        "normalization": { "type": "string", "minLength": 1 },
        "coefficient_policy": { "type": "string", "minLength": 1 },
        "permitted_approximations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree", "module", "entrypoint", "intermediates_entrypoint", "call_site", "arguments", "host_module", "mechanism_weight_flag"],
      "properties": {
        "tree": { "type": "string", "minLength": 1 },
        "module": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "intermediates_entrypoint": { "type": "string", "minLength": 1 },
        "call_site": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "shape", "role"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "shape": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "host_module": { "type": "string", "minLength": 1 },
        "mechanism_weight_flag": { "type": "string", "minLength": 1 }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation", "symbols", "parameters", "reference_implementation", "reference_symbols"],
      "properties": {
        "equation": { "type": "string", "minLength": 1 },
        "symbols": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "number" }
        },
        "reference_implementation": { "type": "string", "minLength": 1 },
        "reference_symbols": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gradient_targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "enum": ["nonzero", "zero", "finite"] }
    },
    "forbidden_substitutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "why"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "pattern": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "statement": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["numeric", "metamorphic", "structural"] }
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "boundary", "degenerate"],
      "properties": {
        "positive": { "$ref": "#/$defs/caseList" },
        "negative": { "$ref": "#/$defs/caseList" },
        "boundary": { "$ref": "#/$defs/caseList" },
        "degenerate": { "$ref": "#/$defs/caseList" }
      }
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["atol", "rtol"],
        "properties": {
          "atol": { "type": "number", "minimum": 0 },
          "rtol": { "type": "number", "minimum": 0 },
          "dtype": { "type": "string" },
          "device": { "type": "string" }
        }
      }
    },
    "cgv_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "model", "forward_contract", "gradient_contract", "update_contract", "distributed_contract", "runtime_contract"],
      "properties": {
        "mechanism": { "type": "object" },
        "model": { "type": "object" },
        "forward_contract": { "type": "object" },
        "gradient_contract": { "type": "object" },
        "update_contract": { "type": "object" },
        "distributed_contract": { "type": "object" },
        "runtime_contract": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_by", "authored_at", "review", "source_digests", "dataset_digests"],
      "properties": {
        "authored_by": { "type": "string", "minLength": 1 },
        "authored_at": { "type": "string", "minLength": 1 },
        "review": { "type": "string", "minLength": 1 },
        "source_digests": { "type": "object" },
        "dataset_digests": { "type": "object" }
      }
    },
    "judges": {
      "type": "array",
      "description": "The independent checks this mechanism's declaration calls for. Harness2 selects from the registry; an unknown name is refused.",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    }
  },
  "$defs": {
    "caseList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "inputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "role": { "type": "string", "enum": ["positive", "negative", "boundary", "degenerate"] },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["z_src", "z_tgt", "codebook", "mask"],
            "properties": {
              "z_src": { "$ref": "#/$defs/matrix" },
              "z_tgt": { "$ref": "#/$defs/matrix" },
              "codebook": { "$ref": "#/$defs/matrix" },
              "mask": { "$ref": "#/$defs/vector" }
            }
          }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number" }
    }
  }
}
