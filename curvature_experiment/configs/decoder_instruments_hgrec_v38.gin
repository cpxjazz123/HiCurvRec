# Decoder Musical_Instruments config — v38 备胎 (Issue258)
# HALC v38 per-token input-dependent κ + Stage 2 TCU init=0.3
#
# === v38 创新点 (R36 新曲率机制 — per-token 粒度) ===
# 1. Per-token input-dependent κ: 每个 token 自己的 c_t ∈ R^(B, L)
#    c_t = (softplus(log_c_l) + δ(‖h_t‖)) * sigmoid((t - warmup) / cooldown)
#    δ(‖h_t‖) = per-layer linear(1→1) (init bias=0, scale=0.01 → 起点与 v2 等价)
# 2. Stage 2 TCU init=0.3 (跨 stage 几何迁移 — R36 框架级变更)
#    init_curvature = 0.3 (Stage 2 RQ-VAE 学到的 c_l 真值)
# 3. reg_weight_max = 0.06 (R36 框架级变更 — 温和增强)
#
# === R36 合规性 (非 sweep — 真正新曲率机制) ===
# - per-token κ: 不同于 v2 per-layer / v12 per-head / v36 per-token reg_weight
# - Stage 2 TCU init: 跨 stage 曲率迁移 (与 v10 一致, 已被历史 v13 验证可行)
#
# === 期望 ===
# - vs v19 baseline test_R@10=0.1113: +0.005 → 0.116 (R37 PASS)
# - vs v34 HyperbolicRMSNorm test_R@10=0.1077: +0.013 → 0.12 (R37 GO)
# - 目标 test_R@10 ≥ 0.12 (R36 严格化几何改造方向)

import train_decoder  # noqa: F401  注册 @gin.configurable

# === 启用 HG-Rec 路径 (与 v19 baseline 一致) ===
train_decoder.train.use_hgrec_arch = True

# === 启用 HALC v38 (核心创新开关) ===
train_decoder.train.use_halc_v38 = True

# === HG-Rec T5Config (与 v19 严格对齐) ===
train_decoder.train.hgrec_t5_d_model = 128
train_decoder.train.hgrec_t5_d_ff = 1024
train_decoder.train.hgrec_t5_num_heads = 6
train_decoder.train.hgrec_t5_d_kv = 64
train_decoder.train.hgrec_t5_num_layers = 6
train_decoder.train.hgrec_t5_num_decoder_layers = 4
train_decoder.train.hgrec_t5_dropout = 0.1
train_decoder.train.hgrec_vocab_size = 769
train_decoder.train.hgrec_max_len = 20

# === HG-Rec 数据 (v38 SID numpy — Stage 1+2 实时重跑) ===
# Stage 1 重训: rqvae_out_v38_cend_07/rqvae_final.pt (c_end=0.7 同 v19)
# Stage 2 重训: dataset/Instruments/Instruments_v38_sids_for_hgrec.npy
train_decoder.train.hgrec_code_path = "/home/wlia0047/ar57/wenyu/GeneRec/curvature_experiment/dataset/Instruments/Instruments_v38_sids_for_hgrec.npy"

# === 训练超参 (与 v19 一致, R36 禁调参) ===
train_decoder.train.hgrec_batch_size = 3072
train_decoder.train.batch_size = 3072
train_decoder.train.learning_rate = 0.0001
train_decoder.train.weight_decay = 0.0001
train_decoder.train.amp = True
train_decoder.train.mixed_precision_type = "bf16"

# === Eval 配置 (与 v19 一致) ===
train_decoder.train.top_k_for_generation = 20
train_decoder.train.top_k_eval_list = [5, 10, 20]

# === 保存路径 (R35 禁 Borda, 单 ckpt + beam=20) — 绝对路径避免 cwd 嵌套错 ===
train_decoder.train.save_dir_root = "/home/wlia0047/ar57/wenyu/GeneRec/curvature_experiment/out/decoder/instruments_hgrec_v38/"

# === gin 必填项 ===
train_decoder.train.dataset_folder = "dataset/"
train_decoder.train.dataset = "INSTRUMENTS"
train_decoder.train.force_dataset_process = False
train_decoder.train.dataset_split = "instruments"
train_decoder.train.full_eval_every = 500
train_decoder.train.partial_eval_every = 250
train_decoder.train.wandb_logging = False

# === HG-Rec 路径不读取的占位 ===
train_decoder.train.t5_d_model = 384
train_decoder.train.t5_num_heads = 6
train_decoder.train.t5_d_ff = 1024
train_decoder.train.t5_num_layers = 4
train_decoder.train.t5_num_decoder_layers = 4
train_decoder.train.should_add_sep_token = False
train_decoder.train.pretrained_rqvae_path = ""
train_decoder.train.vae_input_dim = 768
train_decoder.train.vae_hidden_dims = [512, 256, 128]
train_decoder.train.vae_embed_dim = 32
train_decoder.train.vae_codebook_size = 256
train_decoder.train.vae_n_layers = 3
train_decoder.train.vae_n_cat_feats = 0
train_decoder.train.iterations = 500000
train_decoder.train.gradient_accumulate_every = 1
train_decoder.train.split_batches = True
train_decoder.train.vae_codebook_normalize = False