 "code": "import torch\nimport math\n\n\ndef compute(x, y, curvature):\n    eps = 1e-12\n    c = curvature\n    c_zero = (c == 0.0) if not torch.is_tensor(c) else bool(torch.all(c == 0.0))\n    if c_zero:\n        diff = x - y\n        return (2.0 * torch.sqrt(torch.clamp((diff * diff).sum(-1), min=0.0))).reshape(-1)\n\n    x0 = x[..., 0]\n    x1 = x[..., 1]\n    y0 = y[..., 0]\n    y1 = y[..., 1]\n\n    xy = -(x0 * y0 + x1 * y1)\n    xn = x0 * x0 + x1 * x1\n    yn = y0 * y0 + y1 * y1\n\n    a = 1.0 + 2.0 * c * xy + c * yn\n    b = 1.0 - c * xn\n    num0 = a * (-x0) + b * y0\n    num1 = a * (-x1) + b * y1\n    den = 1.0 + 2.0 * c * xy + c * c * xn * yn + eps\n\n    mx0 = num0 / den\n    mx1 = num1 / den\n    mn = mx0 * mx0 + mx1 * mx1\n\n    rootc = torch.sqrt(torch.as_tensor(c, dtype=mn.dtype, device=mn.device))\n    arg = rootc * torch.sqrt(torch.clamp(mn, min=0.0))\n    arg = torch.clamp(arg, max=1.0 - 1e-6)\n    d = (2.0 / rootc) * torch.atanh(arg)\n    return d.reshape(-1)\n",
