 "output": "d",
 "code": "import torch\n\ndef compute(x, y, curvature):\n    c = torch.as_tensor(curvature, dtype=x.dtype, device=x.device)\n    x0 = x[..., 0]\n    x1 = x[..., 1]\n    y0 = y[..., 0]\n    y1 = y[..., 1]\n    xy = -(x0 * y0 + x1 * y1)\n    xn = x0 * x0 + x1 * x1\n    yn = y0 * y0 + y1 * y1\n    num0 = (1 + 2 * c * xy + c * yn) * (-x0) + (1 - c * xn) * y0\n    num1 = (1 + 2 * c * xy + c * yn) * (-x1) + (1 - c * xn) * y1\n    den = 1 + 2 * c * xy + c * c * xn * yn + 1e-12\n    mx0 = num0 / den\n    mx1 = num1 / den\n    mn = mx0 * mx0 + mx1 * mx1\n    arg = torch.clamp(torch.sqrt(c) * torch.sqrt(mn), max=1.0 - 1e-6)\n    d = (2.0 / torch.sqrt(c)) * torch.atanh(arg)\n    return d.reshape(-1)\n",
