{"symbols":["x0","x1","y0","y1","c"],"args":[{"name":"x","width":2,"radius":0.4},{"name":"y","width":2,"radius":0.4},{"name":"curvature","scalar":1.0}],"statements":["xy = -(x0*y0 + x1*y1)","xn = x0**2 + x1**2","yn = y0**2 + y1**2","num0 = (1 + 2*c*xy + c*yn)*(-x0) + (1 - c*xn)*y0","num1 = (1 + 2*c*xy + c*yn)*(-x1) + (1 - c*xn)*y1","den = 1 + 2*c*xy + c**2*xn*yn + 1e-12","mx0 = num0/den","mx1 = num1/den","mn = mx0**2 + mx1**2","d = 2/sqrt(c)*atanh(Min(sqrt(c)*sqrt(mn), 1 - 1e-6))"],"output":"d","code":"import torch\n\ndef compute(x, y, curvature):\n    eps = 1e-12\n    c = curvature\n    x0 = x[..., 0]\n    x1 = x[..., 1]\n    y0 = y[..., 0]\n    y1 = y[..., 1]\n    xy = -(x0 * y0 + x1 * y1)\n    xn = x0 * x0 + x1 * x1\n    yn = y0 * y0 + y1 * y1\n    num0 = (1 + 2 * c * xy + c * yn) * (-x0) + (1 - c * xn) * y0\n    num1 = (1 + 2 * c * xy + c * yn) * (-x1) + (1 - c * xn) * y1\n    den = 1 + 2 * c * xy + c * c * xn * yn + eps\n    mx0 = num0 / den\n    mx1 = num1 / den\n    mn = mx0 * mx0 + mx1 * mx1\n    d = (2.0 / torch.sqrt(c)) * torch.atanh(torch.clamp(torch.sqrt(c) * torch.sqrt(mn), max=1.0 - 1e-6))\n    return d.reshape(-1)\n","excluded":[]}
