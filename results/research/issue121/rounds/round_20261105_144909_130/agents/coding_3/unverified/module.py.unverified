import math

import torch

EPS = 1e-12
TAU = 1.0
RHO = 0.5
RHO_OFF = 0.10
ETA = 0.1


def _norm(v):
    return torch.sqrt(torch.clamp((v * v).sum(-1), min=0.0))


def lift(v, c):
    if c == 0.0:
        return v
    s = math.sqrt(c)
    n = _norm(v)
    return v * (torch.tanh(s * n) / (s * n + EPS)).unsqueeze(-1)


def mobius(x, y, c):
    xy = (x * y).sum(-1, keepdim=True)
    xx = (x * x).sum(-1, keepdim=True)
    yy = (y * y).sum(-1, keepdim=True)
    num = (1 + 2 * c * xy + c * yy) * x + (1 - c * xx) * y
    den = 1 + 2 * c * xy + c * c * xx * yy + EPS
    return num / den


def dist(x, y, c):
    if c == 0.0:
        return 2.0 * _norm(x - y)
    s = math.sqrt(c)
    return (2.0 / s) * torch.atanh(
        torch.clamp(s * _norm(mobius(-x, y, c)), max=1.0 - 1e-6)
    )


def level_score(residual, codebook, curvature, demand, weight):
    c = float(curvature)
    u = lift(residual, c)
    q = lift(codebook, c)
    D_k = dist(u[:, None, :], q[None, :, :], c)
    off_k = float(weight) * torch.log1p(demand)
    score_k = D_k - off_k[None, :]
    k1 = torch.argmin(score_k, dim=-1)
    return {
        "k1": k1,
        "score_k": score_k,
        "D_k": D_k,
        "off_k": off_k,
        "u": u,
        "q": q,
        "r_next": residual - codebook[k1],
        "p_ik": torch.softmax(-D_k / TAU, dim=-1),
    }

