import math

import torch

EPS = 1e-12
TAU = 1.0
RHO = 0.5
RHO_OFF = 0.10
ETA = 0.1
ARCTANH_MAX = 1.0 - 1e-6


def _norm(v):
    return torch.sqrt(torch.clamp((v * v).sum(-1), min=0.0))


def lift(v, c):
    if c == 0.0:
        return v
    sc = math.sqrt(c)
    n = _norm(v)
    return v * (torch.tanh(sc * n) / (sc * n + EPS)).unsqueeze(-1)


def mobius(x, y, c):
    xy = (x * y).sum(-1, keepdim=True)
    yy = (y * y).sum(-1, keepdim=True)
    xx = (x * x).sum(-1, keepdim=True)
    den = 1.0 + 2.0 * c * xy + c * c * xx * yy + EPS
    return ((1.0 + 2.0 * c * xy + c * yy) * x + (1.0 - c * xx) * y) / den


def dist(x, y, c):
    if c == 0.0:
        return 2.0 * _norm(x - y)
    arg = math.sqrt(c) * _norm(mobius(-x, y, c))
    return (2.0 / math.sqrt(c)) * torch.atanh(torch.clamp(arg, max=ARCTANH_MAX))


def compute_scale(latents, rho=RHO):
    n = _norm(latents)
    s_val = float(torch.sqrt(torch.clamp((n * n).mean(), min=0.0)).detach())
    if not math.isfinite(s_val) or s_val <= 0.0:
        raise ValueError(
            'frozen scale s is not finite or not positive (s=%r): the run stops, s is never replaced by a default' % (s_val,)
        )
    return s_val, (rho / s_val) ** 2


def item_mass(t_ij):
    out_i = t_ij.sum(-1)
    in_j = t_ij.sum(0)
    den = torch.sqrt(out_i[:, None] * in_j[None, :] + EPS)
    return (t_ij / den).sum(-1)


def behaviour_demand(p_ik, m_i):
    num_k = (p_ik * m_i[:, None]).sum(0)
    den_k = p_ik.sum(0)
    return num_k / (den_k + EPS)


def update_b_raw(b_raw, b_raw_epoch, eta=ETA):
    with torch.no_grad():
        return ((1.0 - eta) * b_raw + eta * b_raw_epoch).detach()


def demand_log(b_raw):
    return torch.log1p(b_raw / b_raw.mean())


def offset_weight(mean_scale, b_k, rho_off=RHO_OFF):
    return rho_off * float(mean_scale) / torch.log1p(b_k).max()


def offsets(b_k, weight):
    if float(weight) == 0.0:
        return torch.zeros_like(b_k)
    return float(weight) * torch.log1p(b_k)


def level_score(residual, codebook, curvature, demand, weight):
    c = float(curvature)
    u = lift(residual, c)
    q = lift(codebook, c)
    D_k = dist(u[:, None, :], q[None, :, :], c)
    off = offsets(demand, weight)
    return D_k - off[None, :]


def level_assign(score_k):
    return torch.argmin(score_k, dim=-1)


def residual_recursion(r, codebook, k1):
    return r - codebook[k1]


def soft_assignment(D_k, tau=TAU):
    return torch.softmax(-D_k / tau, dim=-1)


def epoch_mean_scale(ms_sum, ms_count):
    return ms_sum / ms_count


def epoch_offset_weight(epoch, behaviour_off, mean_scale, b_k, rho_off=RHO_OFF):
    if behaviour_off or epoch == 1:
        return 0.0
    return float(rho_off) * float(mean_scale) / float(torch.log1p(b_k).max())

