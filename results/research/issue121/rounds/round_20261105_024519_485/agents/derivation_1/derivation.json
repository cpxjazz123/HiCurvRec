"code": "import torch\n\n\ndef _exp_o(v):\n    v0 = v[..., 0]\n    v1 = v[..., 1]\n    n = torch.sqrt(v0 * v0 + v1 * v1)\n    pos = n > 0\n    n_safe = torch.where(pos, n, torch.ones_like(n))\n    m0 = torch.cosh(n)\n    m1 = torch.where(pos, torch.sinh(n_safe) * v0 / n_safe, v0)\n    m2 = torch.where(pos, torch.sinh(n_safe) * v1 / n_safe, v1)\n    return m0, m1, m2\n\n\ndef compute(z, theta_1_1, theta_1_2, theta_2_1, theta_2_2, s, v_pi_1, v_pi_2):\n    z = torch.as_tensor(z)\n    dtype = z.dtype\n\n    def _t(x):\n        return torch.as_tensor(x, dtype=dtype)\n\n    theta_1_1 = _t(theta_1_1)\n    theta_1_2 = _t(theta_1_2)\n    theta_2_1 = _t(theta_2_1)\n    theta_2_2 = _t(theta_2_2)\n    v_pi_1 = _t(v_pi_1)\n    v_pi_2 = _t(v_pi_2)\n    s_t = _t(s)\n    if s_t.dim() > 0:\n        s_t = s_t.reshape(-1, 1)\n\n    rz = z / s_t\n    rz0 = rz[..., 0]\n    rz1 = rz[..., 1]\n\n    m1_0, m1_1, m1_2 = _exp_o(v_pi_1)\n    h1 = 1.0 + m1_0\n\n    u11 = m1_1 * theta_1_1[..., 0] + m1_2 * theta_1_1[..., 1]\n    u12 = m1_1 * theta_1_2[..., 0] + m1_2 * theta_1_2[..., 1]\n\n    A11_0 = u11\n    A11_1 = theta_1_1[..., 0] + u11 * m1_1 / h1\n    A11_2 = theta_1_1[..., 1] + u11 * m1_2 / h1\n    A12_0 = u12\n    A12_1 = theta_1_2[..., 0] + u12 * m1_1 / h1\n    A12_2 = theta_1_2[..., 1] + u12 * m1_2 / h1\n\n    W11_0 = A11_0 - A11_0 * (1.0 + m1_0) / h1\n    W11_1 = A11_1 - A11_0 * m1_1 / h1\n    W11_2 = A11_2 - A11_0 * m1_2 / h1\n    W12_0 = A12_0 - A12_0 * (1.0 + m1_0) / h1\n    W12_1 = A12_1 - A12_0 * m1_1 / h1\n    W12_2 = A12_2 - A12_0 * m1_2 / h1\n\n    d2_11 = (0.0 - W11_0) ** 2 - (rz0 - W11_1) ** 2 - (rz1 - W11_2) ** 2\n    d2_12 = (0.0 - W12_0) ** 2 - (rz0 - W12_1) ** 2 - (rz1 - W12_2) ** 2\n\n    first = d2_11 <= d2_12\n    a0 = torch.where(first, W11_0, W12_0)\n    a1 = torch.where(first, W11_1, W12_1)\n    a2 = torch.where(first, W11_2, W12_2)\n\n    e0 = 0.0 - a0\n    e1 = rz0 - a1\n    e2 = rz1 - a2\n    ae = -a0 * e0 + a1 * e1 + a2 * e2\n    ka = 1.0 + a0\n    r2_0 = e0 + (ae / ka) * (1.0 + a0)\n    r2_1 = e1 + (ae / ka) * a1\n    r2_2 = e2 + (ae / ka) * a2\n\n    m2_0, m2_1, m2_2 = _exp_o(v_pi_2)\n    h2 = 1.0 + m2_0\n\n    u21 = m2_1 * theta_2_1[..., 0] + m2_2 * theta_2_1[..., 1]\n    u22 = m2_1 * theta_2_2[..., 0] + m2_2 * theta_2_2[..., 1]\n\n    B21_0 = u21\n    B21_1 = theta_2_1[..., 0] + u21 * m2_1 / h2\n    B21_2 = theta_2_1[..., 1] + u21 * m2_2 / h2\n    B22_0 = u22\n    B22_1 = theta_2_2[..., 0] + u22 * m2_1 / h2\n    B22_2 = theta_2_2[..., 1] + u22 * m2_2 / h2\n\n    ma = -m2_0 * a0 + m2_1 * a1 + m2_2 * a2\n    den = 1.0 - ma\n    ab1 = -a0 * B21_0 + a1 * B21_1 + a2 * B21_2\n    ab2 = -a0 * B22_0 + a1 * B22_1 + a2 * B22_2\n\n    W21_0 = B21_0 + (ab1 / den) * (m2_0 + a0)\n    W21_1 = B21_1 + (ab1 / den) * (m2_1 + a1)\n    W21_2 = B21_2 + (ab1 / den) * (m2_2 + a2)\n    W22_0 = B22_0 + (ab2 / den) * (m2_0 + a0)\n    W22_1 = B22_1 + (ab2 / den) * (m2_1 + a1)\n    W22_2 = B22_2 + (ab2 / den) * (m2_2 + a2)\n\n    d2_21 = (r2_0 - W21_0) ** 2 - (r2_1 - W21_1) ** 2 - (r2_2 - W21_2) ** 2\n    d2_22 = (r2_0 - W22_0) ** 2 - (r2_1 - W22_1) ** 2 - (r2_2 - W22_2) ** 2\n\n    loss = torch.minimum(d2_11, d2_12) + torch.minimum(d2_21, d2_22)\n    return loss.reshape(-1)\n"
