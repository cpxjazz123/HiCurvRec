 "code": "import torch\n\n\ndef compute(z, theta, s, M, use_behaviour, use_curvature):\n    z = torch.as_tensor(z)\n    if z.dim() == 1:\n        z = z.reshape(-1, 1)\n    B = z.shape[0]\n    th = torch.as_tensor(theta).reshape(-1)\n    t11, t12, t21, t22 = th[0], th[1], th[2], th[3]\n    s_val = float(s.reshape(-1)[0]) if torch.is_tensor(s) else float(s)\n    b = float(use_behaviour.reshape(-1)[0]) if torch.is_tensor(use_behaviour) else float(use_behaviour)\n    kap = float(use_curvature.reshape(-1)[0]) if torch.is_tensor(use_curvature) else float(use_curvature)\n    Mv = torch.as_tensor(M, dtype=z.dtype).reshape(-1)\n    if Mv.numel() == 1:\n        Mv = Mv.expand(B)\n\n    r1 = z[:, 0] / s_val\n    sel1 = (r1 - t11) ** 2 <= (r1 - t12) ** 2\n    zero = torch.zeros_like(r1)\n    t1 = torch.where(sel1, t11 + zero, t12 + zero)\n    d1 = r1 - t1\n    a0 = torch.cosh(t1)\n    a1 = torch.sinh(t1)\n    rp0 = torch.sinh(t1) * d1\n    rp1 = torch.cosh(t1) * d1\n\n    Mb = b * Mv\n    m0 = torch.cosh(Mb)\n    m1 = torch.sinh(Mb)\n    ct = torch.cosh(t1 - Mb)\n    st = torch.sinh(t1 - Mb)\n    f1 = kap * t21 * st / (1.0 + ct)\n    f2 = kap * t22 * st / (1.0 + ct)\n    W10 = m1 * t21 + f1 * (m0 + a0)\n    W11 = m0 * t21 + f1 * (m1 + a1)\n    W20 = m1 * t22 + f2 * (m0 + a0)\n    W21 = m0 * t22 + f2 * (m1 + a1)\n    D1 = -(rp0 - W10) ** 2 + (rp1 - W11) ** 2\n    D2 = -(rp0 - W20) ** 2 + (rp1 - W21) ** 2\n    sel2 = D1 <= D2\n    W0 = torch.where(sel2, W10, W20)\n    W1 = torch.where(sel2, W11, W21)\n\n    e0 = rp0 - W0\n    e1 = rp1 - W1\n    ea = -e0 * a0 + e1 * a1\n    ep0 = e0 + ea * a0\n    ep1 = e1 + ea * a1\n    nW = torch.sqrt(W1 ** 2 - W0 ** 2)\n    an0 = torch.cosh(nW) * a0 + torch.sinh(nW) * W0 / nW\n    an1 = torch.cosh(nW) * a1 + torch.sinh(nW) * W1 / nW\n    ane = -an0 * ep0 + an1 * ep1\n    den = 1.0 + a0 * an0 - a1 * an1\n    cc = ane / den\n\n    x_hat = s_val * torch.acosh(an0) * an1 / torch.sqrt(an1 ** 2)\n    return x_hat.reshape(-1)\n",
