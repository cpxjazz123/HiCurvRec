 "statements": [
  "r1 = z/s",
  "t1 = Piecewise((t11, (r1 - t11)**2 <= (r1 - t12)**2), (t12, True))",
  "d1 = r1 - t1",
  "a0 = cosh(t1)",
  "a1 = sinh(t1)",
  "rp0 = sinh(t1)*d1",
  "rp1 = cosh(t1)*d1",
  "Mb = use_behaviour*M",
  "m0 = cosh(Mb)",
  "m1 = sinh(Mb)",
  "ct = cosh(t1 - Mb)",
  "st = sinh(t1 - Mb)",
  "W10 = m1*t21 + use_curvature*t21*st*(m0 + a0)/(1 + ct)",
  "W11 = m0*t21 + use_curvature*t21*st*(m1 + a1)/(1 + ct)",
  "W20 = m1*t22 + use_curvature*t22*st*(m0 + a0)/(1 + ct)",
  "W21 = m0*t22 + use_curvature*t22*st*(m1 + a1)/(1 + ct)",
  "D1 = -(rp0 - W10)**2 + (rp1 - W11)**2",
  "D2 = -(rp0 - W20)**2 + (rp1 - W21)**2",
  "W0 = Piecewise((W10, D1 <= D2), (W20, True))",
  "W1 = Piecewise((W11, D1 <= D2), (W21, True))",
  "e0 = rp0 - W0",
  "e1 = rp1 - W1",
  "ea = -e0*a0 + e1*a1",
  "ep0 = e0 + ea*a0",
  "ep1 = e1 + ea*a1",
  "nW = sqrt(W1**2 - W0**2)",
  "an0 = cosh(nW)*a0 + sinh(nW)*W0/nW",
  "an1 = cosh(nW)*a1 + sinh(nW)*W1/nW",
  "ane = -an0*ep0 + an1*ep1",
  "den = 1 + a0*an0 - a1*an1",
  "cc = ane/den",
  "rn0 = ep0 + cc*(a0 + an0)",
  "rn1 = ep1 + cc*(a1 + an1)",
  "x_hat = s*acosh(an0)*an1/sqrt(an1**2)"
 ],
 "output": "x_hat",
 "code": "import torch\n\n\ndef compute(z, theta, s, M, use_behaviour, use_curvature):\n    z = torch.as_tensor(z)\n    if z.dim() == 1:\n        z = z.reshape(-1, 1)\n    B = z.shape[0]\n    th = torch.as_tensor(theta).reshape(-1)\n    t11, t12, t21, t22 = th[0], th[1], th[2], th[3]\n    s_val = float(s.reshape(-1)[0]) if torch.is_tensor(s) else float(s)\n    b = float(use_behaviour.reshape(-1)[0]) if torch.is_tensor(use_behaviour) else float(use_behaviour)\n    kap = float(use_curvature.reshape(-1)[0]) if torch.is_tensor(use_curvature) else float(use_curvature)\n    Mv = torch.as_tensor(M, dtype=z.dtype).reshape(-1)\n    if Mv.numel() == 1:\n        Mv = Mv.expand(B)\n\n    r1 = z[:, 0] / s_val\n    sel1 = (r1 - t11) ** 2 <= (r1 - t12) ** 2\n    zero = torch.zeros_like(r1)\n    t1 = torch.where(sel1, t11 + zero, t12 + zero)\n    d1 = r1 - t1\n    a0 = torch.cosh(t1)\n    a1 = torch.sinh(t1)\n    rp0 = torch.sinh(t1) * d1\n    rp1 = torch.cosh(t1) * d1\n\n    Mb = b * Mv\n    m0 = torch.cosh(Mb)\n    m1 = torch.sinh(Mb)\n    ct = torch.cosh(t1 - Mb)\n    st = torch.sinh(t1 - Mb)\n    f1 = kap * t21 * st / (1.0 + ct)\n    f2 = kap * t22 * st / (1.0 + ct)\n    W10 = m1 * t21 + f1 * (m0 + a0)\n    W11 = m0 * t21 + f1 * (m1 + a1)\n    W20 = m1 * t22 + f2 * (m0 + a0)\n    W21 = m0 * t22 + f2 * (m1 + a1)\n    D1 = -(rp0 - W10) ** 2 + (rp1 - W11) ** 2\n    D2 = -(rp0 - W20) ** 2 + (rp1 - W21) ** 2\n    sel2 = D1 <= D2\n    W0 = torch.where(sel2, W10, W20)\n    W1 = torch.where(sel2, W11, W21)\n\n    e0 = rp0 - W0\n    e1 = rp1 - W1\n    ea = -e0 * a0 + e1 * a1\n    ep0 = e0 + ea * a0\n    ep1 = e1 + ea * a1\n    nW = torch.sqrt(W1 ** 2 - W0 ** 2)\n    an0 = torch.cosh(nW) * a0 + torch.sinh(nW) * W0 / nW\n    an1 = torch.cosh(nW) * a1 + torch.sinh(nW) * W1 / nW\n    ane = -an0 * ep0 + an1 * ep1\n    den = 1.0 + a0 * an0 - a1 * an1\n    cc = ane / den\n\n    x_hat = s_val * torch.acosh(an0) * an1 / torch.sqrt(an1 ** 2)\n    return x_hat.reshape(-1)\n",
 "excluded": [
  "the discrete token matrix tok[b,l] (k_l acts only through the Piecewise-selected W; the emitted index itself is bookkeeping)",
  "the stop-gradient codebook/commitment loss terms (sg(r_{l-1}) - W_{k_l} squared Minkowski norms, beta weighting)",
  "anchor-table construction and refresh (no-grad forward over 24556 items every 25 epochs, row-normalised transition mass, 99th-percentile norm clip, <5 items or no outgoing mass -> v_pi = 0); here v_pi is the given input M and use_behaviour = 0 reproduces the zero fallback",
  "the RMS scale s is a frozen measured constant (an input, not recomputed)",
  "the unchanged decoder and the baseline reconstruction term",
  "the instantiation is D=1, L=2, K=2 (scalar components); further levels repeat the same level-2 block verbatim with a as the new base point"
 ]
}
