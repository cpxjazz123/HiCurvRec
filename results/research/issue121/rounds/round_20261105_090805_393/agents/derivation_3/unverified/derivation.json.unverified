 "statements": [
  "kappa = 1.0638",
  "p = 0.9/s",
  "a0 = p*z0",
  "a1 = p*z1",
  "an = sqrt(a0**2 + a1**2)",
  "x0 = tanh(Min(an, 0.9))*a0/Max(an, 1e-12)",
  "x1 = tanh(Min(an, 0.9))*a1/Max(an, 1e-12)",
  "n11 = sqrt(theta1_1_0**2 + theta1_1_1**2)",
  "e11_0 = theta1_1_0*Min(1, 0.9/Max(n11, 1e-12))",
  "e11_1 = theta1_1_1*Min(1, 0.9/Max(n11, 1e-12))",
  "c11_0 = tanh(Min(n11, 0.9))*theta1_1_0/Max(n11, 1e-12)",
  "c11_1 = tanh(Min(n11, 0.9))*theta1_1_1/Max(n11, 1e-12)",
  "n12 = sqrt(theta1_2_0**2 + theta1_2_1**2)",
  "e12_0 = theta1_2_0*Min(1, 0.9/Max(n12, 1e-12))",
  "e12_1 = theta1_2_1*Min(1, 0.9/Max(n12, 1e-12))",
  "c12_0 = tanh(Min(n12, 0.9))*theta1_2_0/Max(n12, 1e-12)",
  "c12_1 = tanh(Min(n12, 0.9))*theta1_2_1/Max(n12, 1e-12)",
  "u11 = (x0 - c11_0)**2 + (x1 - c11_1)**2",
  "ax1 = Max(0.05, Min(1, 1 - kappa*(x0**2 + x1**2)))",
  "ac11 = Max(0.05, Min(1, 1 - kappa*(c11_0**2 + c11_1**2)))",
  "D11 = acosh(Max(1 + 2*kappa*u11/(ax1*ac11), 1 + 1e-6))/sqrt(kappa)",
  "u12 = (x0 - c12_0)**2 + (x1 - c12_1)**2",
  "ac12 = Max(0.05, Min(1, 1 - kappa*(c12_0**2 + c12_1**2)))",
  "D12 = acosh(Max(1 + 2*kappa*u12/(ax1*ac12), 1 + 1e-6))/sqrt(kappa)",
  "e1s0 = Piecewise((e11_0, D11 <= D12), (e12_0, True))",
  "e1s1 = Piecewise((e11_1, D11 <= D12), (e12_1, True))",
  "r20 = z0 - (s/0.9)*e1s0",
  "r21 = z1 - (s/0.9)*e1s1",
  "b0 = (0.9/s)*r20",
  "b1 = (0.9/s)*r21",
  "bn = sqrt(b0**2 + b1**2)",
  "y0 = tanh(Min(bn, 0.9))*b0/Max(bn, 1e-12)",
  "y1 = tanh(Min(bn, 0.9))*b1/Max(bn, 1e-12)",
  "n21 = sqrt(theta2_1_0**2 + theta2_1_1**2)",
  "e21_0 = theta2_1_0*Min(1, 0.9/Max(n21, 1e-12))",
  "e21_1 = theta2_1_1*Min(1, 0.9/Max(n21, 1e-12))",
  "c21_0 = tanh(Min(n21, 0.9))*theta2_1_0/Max(n21, 1e-12)",
  "c21_1 = tanh(Min(n21, 0.9))*theta2_1_1/Max(n21, 1e-12)",
  "n22 = sqrt(theta2_2_0**2 + theta2_2_1**2)",
  "e22_0 = theta2_2_0*Min(1, 0.9/Max(n22, 1e-12))",
  "e22_1 = theta2_2_1*Min(1, 0.9/Max(n22, 1e-12))",
  "c22_0 = tanh(Min(n22, 0.9))*theta2_2_0/Max(n22, 1e-12)",
  "c22_1 = tanh(Min(n22, 0.9))*theta2_2_1/Max(n22, 1e-12)",
  "u21 = (y0 - c21_0)**2 + (y1 - c21_1)**2",
  "ax2 = Max(0.05, Min(1, 1 - kappa*(y0**2 + y1**2)))",
  "ac21 = Max(0.05, Min(1, 1 - kappa*(c21_0**2 + c21_1**2)))",
  "D21 = acosh(Max(1 + 2*kappa*u21/(ax2*ac21), 1 + 1e-6))/sqrt(kappa)",
  "u22 = (y0 - c22_0)**2 + (y1 - c22_1)**2",
  "ac22 = Max(0.05, Min(1, 1 - kappa*(c22_0**2 + c22_1**2)))",
  "D22 = acosh(Max(1 + 2*kappa*u22/(ax2*ac22), 1 + 1e-6))/sqrt(kappa)",
  "loss = Min(D11**2, D12**2) + Min(D21**2, D22**2)"
 ],
 "output": "loss",
 "code": "import torch\n\n\ndef compute(z, theta_1_1, theta_1_2, theta_2_1, theta_2_2, s):\n    kappa = 1.0638\n    eps = 1e-12\n\n    def _prep(v):\n        return v if v.dim() == 2 else v.unsqueeze(0)\n\n    def exp0(v):\n        v = _prep(v)\n        n = v.norm(dim=1, keepdim=True)\n        return torch.tanh(torch.clamp(n, max=0.9)) * v / torch.clamp(n, min=eps)\n\n    def tangent(v):\n        v = _prep(v)\n        n = v.norm(dim=1, keepdim=True)\n        return v * torch.clamp(0.9 / torch.clamp(n, min=eps), max=1.0)\n\n    def dist(x, c):\n        c = _prep(c)\n        u2 = ((x - c) ** 2).sum(dim=1)\n        ax = torch.clamp(1.0 - kappa * (x ** 2).sum(dim=1), min=0.05, max=1.0)\n        ac = torch.clamp(1.0 - kappa * (c ** 2).sum(dim=1), min=0.05, max=1.0)\n        arg = 1.0 + 2.0 * kappa * u2 / (ax * ac)\n        arg = torch.clamp(arg, min=1.0 + 1e-6)\n        return torch.acosh(arg) / (kappa ** 0.5)\n\n    z = _prep(z)\n    x1 = exp0((0.9 / s) * z)\n    c11 = exp0(theta_1_1)\n    c12 = exp0(theta_1_2)\n    d1 = torch.stack([dist(x1, c11), dist(x1, c12)], dim=1)\n    e1 = torch.cat([tangent(theta_1_1), tangent(theta_1_2)], dim=0)\n    idx = torch.argmin(d1.detach(), dim=1)\n    r2 = z - (s / 0.9) * e1[idx]\n    x2 = exp0((0.9 / s) * r2)\n    c21 = exp0(theta_2_1)\n    c22 = exp0(theta_2_2)\n    d2 = torch.stack([dist(x2, c21), dist(x2, c22)], dim=1)\n    return d1.min(dim=1).values ** 2 + d2.min(dim=1).values ** 2\n",
 "excluded": [
  "the hard assignment k* = argmin_k D_{l,k}: detached argmin, no gradient path, only the resulting D_{l,k*} enters the loss",
  "the behaviour table b_i/pop_i and the occupancy/phi accumulators: not arguments, so rho=1 and kappa = kappa_max/sqrt(e) = 1.754/1.6487 = 1.0638 = kappa0 for every codeword",
  "the stateful EMA of s_l and of hard counts occ_{l,k} with the prefix SIDs: s is supplied frozen and detached",
