{
 "symbols": [
  "z0",
  "z1",
  "theta1_1_0",
  "theta1_1_1",
  "theta1_2_0",
  "theta1_2_1",
  "theta2_1_0",
  "theta2_1_1",
  "theta2_2_0",
  "theta2_2_1",
  "s",
  "v_pi1_0",
  "v_pi1_1",
  "v_pi2_0",
