 ],
 "args": [
  {
   "name": "z",
   "width": 2,
   "radius": 0.4,
   "scalar": 0.2
  }
 ],
 "statements": [
  "a = Abs(s)",
  "nz = sqrt(z0**2 + z1**2)",
  "fz = Piecewise((a*tanh(nz/a)/nz, nz > 0), (1, True))",
  "u0 = fz*z0",
  "u1 = fz*z1",
  "arg10 = (sqrt((u0 - theta1_1_0)**2 + (u1 - theta1_1_1)**2)/a)/sqrt((1 - (u0**2 + u1**2)/a**2)*(1 - (theta1_1_0**2 + theta1_1_1**2)/a**2))",
  "d10 = 2*atanh(Min(arg10, 1 - 10**-6))",
  "c10 = 2*d10**2",
  "arg11 = (sqrt((u0 - theta1_2_0)**2 + (u1 - theta1_2_1)**2)/a)/sqrt((1 - (u0**2 + u1**2)/a**2)*(1 - (theta1_2_0**2 + theta1_2_1**2)/a**2))",
  "d11 = 2*atanh(Min(arg11, 1 - 10**-6))",
  "c11 = 2*d11**2",
  "eps1 = Max(Min(c10, c11), 10**-12)",
  "w10 = Abs(v_pi1_0)",
  "w11 = Abs(v_pi1_1)",
  "e10 = w10*exp(-c10/eps1)",
  "e11 = w11*exp(-c11/eps1)",
  "p10 = e10/(e10 + e11)",
  "p11 = e11/(e10 + e11)",
  "q10 = Piecewise((theta1_1_0, p10 >= p11), (theta1_2_0, True))",
  "q11 = Piecewise((theta1_1_1, p10 >= p11), (theta1_2_1, True))",
  "r20 = z0 - q10",
  "r21 = z1 - q11",
  "nr2 = sqrt(r20**2 + r21**2)",
  "fr2 = Piecewise((a*tanh(nr2/a)/nr2, nr2 > 0), (1, True))",
  "u20 = fr2*r20",
  "u21 = fr2*r21",
  "arg20 = (sqrt((u20 - theta2_1_0)**2 + (u21 - theta2_1_1)**2)/a)/sqrt((1 - (u20**2 + u21**2)/a**2)*(1 - (theta2_1_0**2 + theta2_1_1**2)/a**2))",
  "d20 = 2*atanh(Min(arg20, 1 - 10**-6))",
  "c20 = 2*d20**2",
  "arg21 = (sqrt((u20 - theta2_2_0)**2 + (u21 - theta2_2_1)**2)/a)/sqrt((1 - (u20**2 + u21**2)/a**2)*(1 - (theta2_2_0**2 + theta2_2_1**2)/a**2))",
  "d21 = 2*atanh(Min(arg21, 1 - 10**-6))",
  "c21 = 2*d21**2",
  "eps2 = Max(Min(c20, c21), 10**-12)",
  "w20 = Abs(v_pi2_0)",
  "w21 = Abs(v_pi2_1)",
  "e20 = w20*exp(-c20/eps2)",
  "e21 = w21*exp(-c21/eps2)",
  "p20 = e20/(e20 + e21)",
  "p21 = e21/(e20 + e21)",
  "q20 = Piecewise((theta2_1_0, p20 >= p21), (theta2_2_0, True))",
  "q21 = Piecewise((theta2_1_1, p20 >= p21), (theta2_2_1, True))",
  "loss = (z0 - q10 - q20)**2 + (z1 - q11 - q21)**2"
 ],
 "output": "loss",
 "code": "import torch\n\n\ndef _exp0(v, a):\n    n = torch.linalg.vector_norm(v, dim=-1, keepdim=True)\n    scale = torch.where(n > 0, a * torch.tanh(n / a) / n, torch.ones_like(n))\n    return scale * v\n\n\ndef _scaled_hyperbolic_cost(p, q, a):\n    p2 = (p * p).sum(dim=-1)\n    q2 = (q * q).sum(dim=-1)\n    diff2 = ((p - q) ** 2).sum(dim=-1)\n    a2 = a * a\n    denom = torch.sqrt((1.0 - p2 / a2).clamp_min(1e-12) * (1.0 - q2 / a2).clamp_min(1e-12))\n    arg = (torch.sqrt(diff2) / a) / denom\n    arg = arg.clamp(max=1.0 - 1e-6)\n    d = 2.0 * torch.atanh(arg)\n    return 2.0 * d * d\n\n\ndef _behaviour_plan(c0, c1, v0, v1):\n    eps = torch.minimum(c0, c1).clamp_min(1e-12)\n    e0 = torch.abs(v0) * torch.exp(-c0 / eps)\n    e1 = torch.abs(v1) * torch.exp(-c1 / eps)\n    den = e0 + e1\n    return e0 / den, e1 / den\n\n\ndef compute(z, theta_1_1, theta_1_2, theta_2_1, theta_2_2, s, v_pi_1, v_pi_2):\n    z = z.to(torch.float64) if z.dtype == torch.float32 else z\n    a = torch.abs(torch.as_tensor(s, dtype=z.dtype, device=z.device))\n\n    e1_0 = theta_1_1.to(z)\n    e1_1 = theta_1_2.to(z)\n    e2_0 = theta_2_1.to(z)\n    e2_1 = theta_2_2.to(z)\n\n    u = _exp0(z, a)\n    c10 = _scaled_hyperbolic_cost(u, e1_0, a)\n    c11 = _scaled_hyperbolic_cost(u, e1_1, a)\n    p10, p11 = _behaviour_plan(c10, c11, v_pi_1[..., 0].to(z), v_pi_1[..., 1].to(z))\n    q1_hard = torch.where((p10 >= p11).unsqueeze(-1), e1_0, e1_1)\n    q1_soft = p10.unsqueeze(-1) * e1_0 + p11.unsqueeze(-1) * e1_1\n    q1 = q1_hard + (q1_soft - q1_soft.detach())\n\n    r2 = z - q1\n    u2 = _exp0(r2, a)\n    c20 = _scaled_hyperbolic_cost(u2, e2_0, a)\n    c21 = _scaled_hyperbolic_cost(u2, e2_1, a)\n    p20, p21 = _behaviour_plan(c20, c21, v_pi_2[..., 0].to(z), v_pi_2[..., 1].to(z))\n    q2_hard = torch.where((p20 >= p21).unsqueeze(-1), e2_0, e2_1)\n    q2_soft = p20.unsqueeze(-1) * e2_0 + p21.unsqueeze(-1) * e2_1\n    q2 = q2_hard + (q2_soft - q2_soft.detach())\n\n    loss = ((z - q1 - q2) ** 2).sum(dim=-1)\n    return loss.reshape(-1)\n",
 "excluded": [
  "the hard argmax code index c_i is discrete: only its forward code vector is used, with lowest-index tie handling; the straight-through soft path is value-neutral and carries no forward change",
  "the full batch-coupled 16-iteration log-domain Sinkhorn plan and its 1/B, 1/K marginals are detached after use; the per-item row Gibbs marginal with behaviour prior v_pi supplies the differentiable assignment weight",
  "the previous-epoch successor table and Karcher mean are absent from the fixed signature; the symmetric choice b_i = u_i is used, which only doubles the cost and cancels in the assignment ratio",
  "the epoch statistics q_l and S_l and the resulting stratified curvature scale a_l are collapsed into the single frozen scale s, giving kappa = -1/s^2 at both levels",
  "no auxiliary loss term is added; the reported loss is the unchanged residual reconstruction after the two-level straight-through quantiser"
 ]
