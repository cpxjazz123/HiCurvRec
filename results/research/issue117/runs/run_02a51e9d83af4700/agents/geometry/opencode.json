{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/fs04/ar57/wenyu/GeneRec/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "/fs04/ar57/wenyu/GeneRec/results/research/issue117/runs/run_02a51e9d83af4700/agents/geometry/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "../*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*/../*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*..*",
      "effect": "deny"
    }
  ]
}
