IDEA: successor-framed-rq-l1
{"symbols": ["x0", "x1", "w0", "w1", "t0", "t1"], "args": [{"name": "x", "width": 2}, {"name": "w", "width": 2}, {"name": "t", "width": 2}], "statements": ["x2 = x0**2 + x1**2", "nx = sqrt(x2)", "ex0 = tanh(nx) * x0 / Max(nx, 1e-8)", "ex1 = tanh(nx) * x1 / Max(nx, 1e-8)", "w2 = w0**2 + w1**2", "nw = sqrt(w2)", "c0 = tanh(nw) * w0 / Max(nw, 1e-8)", "c1 = tanh(nw) * w1 / Max(nw, 1e-8)", "t2 = t0**2 + t1**2", "nt = sqrt(t2)", "a0 = tanh(nt) * t0 / Max(nt, 1e-8)", "a1 = tanh(nt) * t1 / Max(nt, 1e-8)", "dotq = -a0*c0 - a1*c1", "a2 = a0**2 + a1**2", "cc2 = c0**2 + c1**2", "denq = 1 + 2*dotq + a2*cc2", "h0 = ((1 + 2*dotq + cc2)*(-a0) + (1 - a2)*c0) / denq", "h1 = ((1 + 2*dotq + cc2)*(-a1) + (1 - a2)*c1) / denq", "dotr = -ex0*h0 - ex1*h1", "ex2 = ex0**2 + ex1**2", "h2 = h0**2 + h1**2", "denr = 1 + 2*dotr + ex2*h2", "r0 = ((1 + 2*dotr + h2)*(-ex0) + (1 - ex2)*h0) / denr", "r1 = ((1 + 2*dotr + h2)*(-ex1) + (1 - ex2)*h1) / denr", "rn = sqrt(r0**2 + r1**2)", "L = (2*atanh(Min(rn, 1 - 1e-7)))**2"], "output": "L", "code": "import torch\n\ndef compute(x, w, t):\n    def exp0(v):\n        n = torch.linalg.norm(v, dim=-1, keepdim=True)\n        return torch.tanh(n) / torch.clamp_min(n, 1e-8) * v\n\n    def madd(u, v):\n        uv = (u * v).sum(dim=-1, keepdim=True)\n        u2 = (u * u).sum(dim=-1, keepdim=True)\n        v2 = (v * v).sum(dim=-1, keepdim=True)\n        den = 1.0 + 2.0 * uv + u2 * v2\n        return ((1.0 + 2.0 * uv + v2) * u + (1.0 - u2) * v) / den\n\n    x = torch.as_tensor(x)\n    w = torch.as_tensor(w)\n    t = torch.as_tensor(t)\n    if x.dim() == 1:\n        x = x.unsqueeze(0)\n    if w.dim() == 1:\n        w = w.unsqueeze(0)\n    if t.dim() == 1:\n        t = t.unsqueeze(0)\n\n    ex = exp0(x)\n    c = exp0(w)\n    a = exp0(t)\n\n    h = madd(-a, c)\n    r = madd(-ex, h)\n    rn = torch.linalg.norm(r, dim=-1)\n    L = (2.0 * torch.atanh(torch.clamp(rn, max=1.0 - 1e-7))) ** 2\n    return L\n", "excluded": ["the argmin code selection k_l and its straight-through estimator: discrete and not differentiable", "the level index L: the formula is instantiated at L=1 with the selected codebook tangent w and anchor tangent t", "the frozen anchor table A_l and SID bookkeeping: precomputed inputs, not part of the differentiable reconstruction loss"]}
