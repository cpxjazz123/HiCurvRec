    {
      "action": "execute",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
