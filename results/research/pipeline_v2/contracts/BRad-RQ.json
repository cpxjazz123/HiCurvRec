{
  "mechanism": "BRad-RQ",
  "hypothesis": "the rank of an item's training context entropy sets its tangent radius, and the Poincare kernel turns that radius into the level code",
  "falsified_by": "the radius or the kernel reaches nothing: two behaviour ranks give the same assignment score, every item sits at the same radius, the scored point is not at the designed radius 0.9q, the export can forget the radius table, or the gradient from the behaviour to the encoder is cut",
  "tests": [
    {
      "template": "SignalSensitivity",
      "set": {
        "callable": "tests.probe_radial.radius_for",
        "arg": "scale"
      },
      "observe": {
        "callable": "tests.probe_radial.observe_cost",
        "arg": "radius"
      }
    },
    {
      "template": "IndependentFormula",
      "candidate": "tests.probe_radial.assignment_path",
      "reference": "closed_form_kernel_1d",
      "grid": {
        "values": [
          0.05,
          0.2,
          0.5
        ],
        "curvature": 1.0
      }
    },
    {
      "template": "RangeAndSaturation",
      "callable": "tests.probe_radial.radius_for",
      "range_source": {
        "mode": "spread",
        "scale": 1.0
      }
    },
    {
      "template": "AssignmentConsistency",
      "compare": {
        "training": "tests.test_radial_export"
      }
    },
    {
      "template": "GradientFlow",
      "module": "tests.test_radial_wiring"
    },
    {
      "template": "CheckpointRestore",
      "module": "tests.test_restore_consistency"
    }
  ],
  "negative_control": {
    "edit": "constant radius",
    "must_fail": "SignalSensitivity"
  },
  "training_config": {
    "radial": "True",
    "frechet_codebook": "False"
  },
  "negative_controls": [
    {
      "edit": "constant radius",
      "must_fail": "SignalSensitivity"
    },
    {
      "edit": "euclidean kernel",
      "must_fail": "IndependentFormula"
    },
    {
      "edit": "cut gradient path",
      "must_fail": "GradientFlow"
    }
  ],
  "training_config_tests": [
    "tests.test_ddp",
    "tests.test_radial_export"
  ]
}
