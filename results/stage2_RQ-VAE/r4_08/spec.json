{
  "schema_version": 1,
  "mechanism": {
    "id": "r4_08",
    "type": "gradient_routing",
    "summary": "project g_L1 against g_base when the two conflict",
    "entrypoints": [
      "r4_project_conflict"
    ],
    "executor": "_r4_08_apply_projection",
    "activation": {
      "requires": [
        "R4_08_PCGRAD_ENC"
      ]
    }
  },
  "model": {
    "adapter": "rqvae",
    "factory": "RQVAE",
    "tokenizer_config": "_tokenizer_config",
    "forward": "forward",
    "parameter_groups": {
      "encoder": "encoder",
      "decoder": "decoder",
      "codebooks": "rq"
    },
    "probe": {
      "n_src": 24,
      "in_dim": 32
    }
  },
  "forward_contract": {
    "observables": [
      "reconstructed",
      "quant_loss",
      "base_loss",
      "recon_loss",
      "tokens"
    ],
    "declared_effect": "none",
    "invariants": [
      {
        "name": "finite"
      },
      {
        "name": "shape",
        "observable": "reconstructed",
        "expected": [
          48,
          32
        ]
      },
      {
        "name": "rows",
        "observable": "tokens",
        "expected": 48
      },
      {
        "name": "tokens_in_range",
        "observable": "tokens",
        "min": 0,
        "max": 255
      },
      {
        "name": "levels",
        "expected": 3
      },
      {
        "name": "residual_identity",
        "tol": 0.0001
      }
    ]
  },
  "gradient_contract": {
    "target": "encoder",
    "mode": "formula",
    "rule": "project_l1_against_base",
    "reference_term": "base_loss",
    "oracle": "oracles:assemble_gradient",
    "eps_flag": "R4_08_EPS",
    "probe_weight": 0.5,
    "probe_seeds": [
      1,
      4,
      5,
      12,
      16,
      30,
      32,
      36
    ],
    "atol": 1e-05,
    "effect": {
      "min_deviation": 1e-06,
      "min_probes": 1
    },
    "loss_terms": {
      "base_loss": "base_loss",
      "l1_loss": "behavior_l1",
      "other_loss": "behavior_other"
    },
    "expected_paths": {
      "base_loss": "nonzero",
      "l1_loss": "nonzero",
      "other_loss": "zero"
    }
  },
  "update_contract": {
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "clip_norm": 1.0,
    "atol": 1e-06,
    "requires_parameter_change": true,
    "oracle": "oracles:optimizer_update"
  },
  "distributed_contract": {
    "world_size": 2,
    "aggregation": "ddp_mean",
    "atol": 1e-05,
    "oracle": "oracles:aggregate"
  },
  "runtime_contract": {
    "entrypoint": "main",
    "isolation": "required",
    "force": {
      "BEHAVIOR_WEIGHT_MAX": 1.0,
      "RAMP_START_EPOCH": 0
    },
    "observe": [
      {
        "name": "mechanism_calls",
        "target": "r4_project_conflict",
        "min": 1
      },
      {
        "name": "optimizer_steps",
        "min": 1
      },
      {
        "name": "parameter_updates",
        "min": 1
      }
    ]
  }
}