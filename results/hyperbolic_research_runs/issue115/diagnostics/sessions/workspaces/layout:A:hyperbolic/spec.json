{
  "mechanism": {
    "id": "hyp_role_assigned_layout",
    "type": "quantization",
    "summary": "a ROLE-ASSIGNED token layout: levels 0 and 1 are the host's residual chain and level 2 quantises the behaviour factor b(x) = normalise(mean_{y in succ(x)} phi(y) - phi(x)) instead of the residual's remainder; the role level's code contributes nothing to the reconstruction, so the reconstruction uses levels 0 and 1 only",
    "entrypoints": [
      "_role_level_loss"
    ],
    "activation": {
      "requires": []
    },
    "executor": "_role_executor",
    "inputs": "_role_term_provider",
    "executor_style": "returns_term"
  },
  "model": {
    "adapter": "rqvae",
    "factory": "RQVAE",
    "tokenizer_config": "_tokenizer_config",
    "forward": "forward",
    "role_inputs": "_probe_role_inputs",
    "parameter_groups": {
      "encoder": "encoder",
      "decoder": "decoder",
      "codebooks": "rq",
      "role_level": "rq.vq_layers.2.embed",
      "codebook": "rq.vq_layers.2.embed"
    },
    "probe": {
      "n_src": 24,
      "in_dim": 32
    }
  },
  "forward_contract": {
    "observables": [
      "reconstructed",
      "quant_loss",
      "base_loss",
      "recon_loss",
      "tokens"
    ],
    "declared_effect": "changes_forward",
    "invariants": [
      {
        "name": "finite"
      },
      {
        "name": "shape",
        "observable": "reconstructed",
        "expected": [
          48,
          32
        ]
      },
      {
        "name": "rows",
        "observable": "tokens",
        "expected": 48
      },
      {
        "name": "tokens_in_range",
        "observable": "tokens",
        "min": 0,
        "max": 255
      },
      {
        "name": "levels",
        "expected": 3
      }
    ]
  },
  "gradient_contract": {
    "target": "codebook",
    "mode": "invariants",
    "loss_terms": {
      "base_loss": "base_loss",
      "role_loss": "declared_callable"
    },
    "loss_term_callables": {
      "role_loss": "_role_level_loss"
    },
    "expected_paths": {
      "base_loss": "nonzero",
      "role_loss": "nonzero"
    },
    "invariants": [
      {
        "name": "finite"
      },
      {
        "name": "nonzero",
        "min_norm": 1e-12
      }
    ],
    "atol": 1e-06,
    "rule": "unprojected",
    "reference_term": "base_loss",
    "alpha": 1.0,
    "eps_flag": "R4_08_EPS"
  },
  "update_contract": {
    "optimizer": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "clip_norm": 1.0,
    "atol": 1e-06,
    "requires_parameter_change": true,
    "oracle": "oracles:optimizer_update"
  },
  "distributed_contract": {
    "world_size": 4,
    "aggregation": "ddp_mean",
    "atol": 1e-05,
    "oracle": "oracles:aggregate",
    "verify_encoder_and_codebook_gradients": true,
    "verify_rank_parameter_identity": true
  },
  "runtime_contract": {
    "entrypoint": "main",
    "isolation": "required",
    "observe": [
      {
        "name": "mechanism_calls",
        "target": "_behaviour_factors",
        "min": 1
      },
      {
        "name": "optimizer_steps",
        "min": 1
      },
      {
        "name": "parameter_updates",
        "min": 1
      }
    ]
  },
  "schema_version": 1
}
