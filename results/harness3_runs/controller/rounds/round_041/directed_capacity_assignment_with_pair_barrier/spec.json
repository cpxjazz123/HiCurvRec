{
  "schema_version": 1,
  "mechanism": {
    "id": "directed_capacity_assignment_with_pair_barrier",
    "type": "loss_term",
    "entrypoints": [
      "mechanism_loss"
    ],
    "executor": "mvg_mechanism_executor",
    "inputs": "mvg_mechanism_inputs",
    "activation": {
      "flag": "MECHANISM_ENABLED"
    },
    "mathematics": {
      "rule": "additive",
      "weight": 0.0001,
      "beta": 2.0,
      "eps": 1e-08,
      "kappa_min": 0.1,
      "kappa_max": 2.0,
      "margin": 0.1,
      "similarity_offset": 0.0,
      "capacity_weight": 1.0,
      "min_pair_separation": 0.01,
      "separation_weight": 1.0,
      "temperature": 0.2
    },
    "summary": "the campaign arm directed_capacity_assignment_with_pair_barrier: a directed curvature-conditioned quantization ranking margin between the level-0 residual of each source item and the nearest codebook row of its target; curvature is bounded and derived from the detached pair similarity"
  },
  "model": {
    "adapter": "rqvae",
    "factory": "RQVAE",
    "forward": "forward",
    "tokenizer_config": "_tokenizer_config",
    "parameter_groups": {
      "encoder": "encoder",
      "codebooks": "rq",
      "decoder": "decoder"
    },
    "probe": {
      "in_dim": 32,
      "n_src": 24
    }
  },
  "forward_contract": {
    "declared_effect": "none",
    "observables": [
      "reconstructed",
      "quant_loss",
      "base_loss",
      "recon_loss",
      "tokens"
    ],
    "invariants": [
      {
        "name": "finite"
      },
      {
        "name": "shape",
        "observable": "reconstructed",
        "expected": [
          48,
          32
        ]
      },
      {
        "name": "rows",
        "observable": "tokens",
        "expected": 48
      },
      {
        "name": "tokens_in_range",
        "observable": "tokens",
        "min": 0,
        "max": 255
      },
      {
        "name": "levels",
        "expected": 3
      },
      {
        "name": "residual_identity",
        "tol": 0.0001
      },
      {
        "name": "finite",
        "observable": "reconstructed"
      }
    ]
  },
  "gradient_contract": {
    "mode": "invariants",
    "target": "encoder",
    "rule": "unprojected",
    "alpha": 0.5,
    "atol": 1e-05,
    "cos_threshold": 0.99,
    "probe_weight": 0.5,
    "reference_term": "base_loss",
    "probe_seeds": [
      1,
      4,
      5,
      12,
      16,
      30,
      32,
      36
    ],
    "loss_terms": {
      "base_loss": "base_loss",
      "l1_loss": "behavior_l1",
      "other_loss": "behavior_other"
    },
    "expected_paths": {
      "base_loss": "nonzero",
      "l1_loss": "nonzero",
      "other_loss": "zero"
    },
    "effect": {
      "min_deviation": 1e-06,
      "min_probes": 1
    },
    "invariants": [
      {
        "name": "finite"
      },
      {
        "name": "nonzero",
        "min_norm": 1e-12
      }
    ]
  },
  "update_contract": {
    "optimizer": "AdamW",
    "oracle": "oracles:optimizer_update",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "clip_norm": 1.0,
    "atol": 1e-06,
    "requires_parameter_change": true
  },
  "distributed_contract": {
    "world_size": 2,
    "aggregation": "ddp_mean",
    "oracle": "oracles:aggregate",
    "atol": 1e-05
  },
  "runtime_contract": {
    "entrypoint": "main",
    "isolation": "required",
    "force": {
      "RAMP_START_EPOCH": 0
    },
    "observe": [
      {
        "name": "mechanism_calls",
        "target": "mvg_mechanism_term",
        "min": 1
      },
      {
        "name": "optimizer_steps",
        "min": 1
      },
      {
        "name": "parameter_updates",
        "min": 1
      },
      {
        "name": "target_encoder_update",
        "min": 1
      }
    ]
  }
}
