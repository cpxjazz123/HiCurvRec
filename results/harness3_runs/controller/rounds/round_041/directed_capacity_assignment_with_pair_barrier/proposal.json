  "differentiation": {
    "occupancy_preservation": "\u8f6f\u5206\u914d\u91cd\u53e0\u9879\u7ecf\u8ddd\u79bb logits \u5bf9 codebook \u4ea7\u751f\u68af\u5ea6\uff1b\u5bb9\u91cf\u9879\u628a source \u7684\u603b\u4f53\u8f6f\u5206\u914d\u63a8\u5411\u5747\u5300\u8fb9\u9645\u3002\u5206\u79bb\u5c4f\u969c\u60e9\u7f5a source \u4e0e target \u8f6f\u5206\u914d\u671f\u671b\u7801\u5411\u91cf\u7684\u8ddd\u79bb\u4f4e\u4e8e m\uff0c\u963b\u6b62\u8be5\u6b63\u5bf9\u901a\u8fc7\u671f\u671b\u7801\u5411\u91cf\u5408\u5e76\u3002\u5b83\u4e0d\u662f\u786c\u5bb9\u91cf\u7ea6\u675f\uff0c\u4e14\u671f\u671b\u8ddd\u79bb\u4e0d\u7b49\u4e8e\u79bb\u6563\u6700\u8fd1\u7801\u5b57\u8ddd\u79bb\uff0c\u4e0d\u80fd\u4fdd\u8bc1\u786c SID \u4e0d\u5408\u5e76\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
