  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u4f5c\u7528\u4e8e\u8f6f\u5206\u914d\u7684\u7801\u672c\u8ddd\u79bb\uff0c\u91cd\u6392\u8f6f Voronoi \u5f52\u5c5e\uff1b\u4ea4\u53c9\u9879\u53ea\u63d0\u9ad8 source \u5206\u914d\u4e0e target \u5206\u914d\u7684\u91cd\u53e0\u6982\u7387\uff0c\u4e0d\u5305\u542b\u76f4\u63a5\u7684 codeword attraction\uff0c\u4e14\u663e\u5f0f\u4f4e\u95f4\u8ddd\u60e9\u7f5a\u5728\u4e24\u7aef\u6700\u8fd1\u7801\u5b57\u9760\u8fd1\u65f6\u4ea7\u751f\u6392\u65a5\u68af\u5ea6\u3002\u5b83\u4e0d\u5f3a\u5236\u6bcf\u5bf9\u5171\u4eab\u7801\u5b57\uff0c\u6545\u4e0d\u80fd\u4fdd\u8bc1 ER \u4e0a\u5347\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u540c\u4e8e encoder-only inert \u9879\uff0c\u8be5\u9879\u5bf9 codebook \u8ddd\u79bb\u6c42\u5bfc\uff1b\u4e0d\u540c\u4e8e\u66fe\u574d\u584c\u7684 directed assignment cross-entropy\uff0c\u5b83\u4e0d\u8981\u6c42\u4e00\u4e2a\u7801\u5b57\u540c\u65f6\u670d\u52a1\u4e24\u7aef\uff0c\u800c\u662f\u7528\u6709\u5411\u8f6f\u5206\u914d\u91cd\u53e0\u6765\u6539\u53d8\u5206\u7ec4\uff0c\u5e76\u5bf9\u6700\u8fd1\u7801\u5b57\u95f4\u8ddd\u8bbe\u7f6e\u663e\u5f0f\u6392\u65a5\u3002\u5b83\u4e0e\u786c\u5bb9\u91cf\u7ea6\u675f\u5206\u914d\u4e0d\u540c\uff0c\u5b9e\u9645 cell \u5c3e\u90e8\u4ecd\u987b\u7531\u51b7\u8dd1\u9a8c\u8bc1\u3002"
      }
    ],
    "vs_reference_arm": "the reference arm is the untouched host; this candidate adds one term whose gradient reaches the codebook without pulling a transition's two codewords together"
  },
  "equation": "\u4ee4 p_s=softmax(-||s-c_k||\u00b2/temperature)\uff0cp_t=softmax(-||t-c_k||\u00b2/temperature)\uff0c\u4e14 A=softmax(-||t-c_k||\u00b2/temperature)\uff1b\u4ee4 r=normalize(p_s)\uff0cz=normalize(A)\uff0c\u5b9a\u4e49 L=weight * mean_mask[ -log(sum_k r_k z_k + eps) + separation_weight * relu(min_separation-||c_{argmax r}-c_{argmax z}||)^2 ]\u3002\u7a7a\u6709\u6548 mask \u65f6 L=0\u3002",
  "expected_failure_modes": [
    "\u8f6f\u5206\u914d\u91cd\u53e0\u53ef\u901a\u8fc7\u8c03\u6574\u5206\u754c\u9762\u5b9e\u73b0\uff0c\u4e5f\u53ef\u80fd\u901a\u8fc7\u5168\u5c40\u8f6f\u6982\u7387\u53d8\u5e73\u5b9e\u73b0\uff1b\u540e\u8005\u4f1a\u964d\u4f4e\u786c\u7801\u4f7f\u7528\u8d28\u91cf\u6216\u5e8f\u5217\u4fe1\u606f\u3002\u5bb9\u91cf\u4fdd\u6301\u5e76\u672a\u7531\u6b64\u516c\u5f0f\u7cbe\u786e\u7ea6\u675f\uff0c\u5fc5\u987b\u4ee5\u51b7\u8dd1\u786c\u5bfc\u51fa\u6d4b\u91cf\u6700\u5927 cell\u3001\u4f7f\u7528\u7801\u6570\u3001\u5206\u652f\u3001\u6f02\u79fb\u548c\u5e8f\u5217\u4fe1\u606f\uff0c\u4e14\u53ea\u6309\u51bb\u7ed3\u4e09\u9608\u503c\u5224\u6210\u529f\u3002"
  ],
