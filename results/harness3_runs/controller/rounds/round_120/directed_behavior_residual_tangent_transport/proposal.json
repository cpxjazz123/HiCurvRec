  "differentiation": {
    "occupancy_preservation": "\u7801\u672c\u68af\u5ea6\u7ecf\u7531 r_s\u3001r_t \u6539\u53d8\u6b8b\u5dee\u51e0\u4f55\uff1b\u76ee\u6807\u662f\u8ba9\u6b8b\u5dee\u5dee\u6cbf\u6709\u5411\u884c\u4e3a\u65b9\u5411\u589e\u52a0\uff0c\u4e0d\u662f\u8ba9\u4e24\u4e2a codeword \u5408\u5e76\u3002\u663e\u5f0f\u6700\u5c0f\u95f4\u8ddd\u9879\u5728\u7aef\u70b9\u7801\u5b57\u8fc7\u8fd1\u65f6\u628a\u5b83\u4eec\u63a8\u5f00\uff0c\u56e0\u6b64\u76f4\u63a5\u9488\u5bf9 pair-convergence \u98ce\u9669\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u5b83\u4e0d\u662f\u4ec5\u4f5c\u7528\u4e8e encoder \u7684 pairwise margin\uff0c\u56e0\u6b64\u4e0d\u4f1a\u88ab\u5bbf\u4e3b\u5b8c\u5168\u8986\u76d6\uff1b\u5b83\u4e0d\u540c\u4e8e residual geometry transport \u7684\u65e0\u7ea6\u675f\u63a8\u62c9\uff0c\u4e5f\u4e0d\u540c\u4e8e pairwise curvature \u5c06\u914d\u5bf9\u7aef\u70b9\u62c9\u8fd1\uff0c\u56e0\u4e3a\u6b8b\u5dee\u76ee\u6807\u6309\u6709\u5411\u884c\u4e3a\u8f74\u5de5\u4f5c\uff0c\u5e76\u5728\u7801\u5b57\u8ddd\u79bb\u4e0d\u8db3\u65f6\u663e\u5f0f\u65bd\u52a0\u5206\u79bb\u68af\u5ea6\u3002\u4efb\u4f55\u4e0b\u6e38\u6539\u5584\u4ecd\u987b\u5b9e\u6d4b\uff0c\u4e0d\u80fd\u7531\u673a\u5236\u63cf\u8ff0\u63a8\u65ad\u3002"
      }
