  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u901a\u8fc7 r_s\u3001r_t \u5bf9\u5e94\u7684\u4e24\u4e2a\u6700\u8fd1\u7801\u5b57\u4ea7\u751f\u76f8\u53cd\u6b8b\u5dee\u66f4\u65b0\uff0c\u4e3b\u8981\u6539\u53d8\u884c\u4e3a\u65b9\u5411\u6b63\u4ea4\u5b50\u7a7a\u95f4\u4e2d\u7684\u6b8b\u5dee\u51e0\u4f55\uff1b\u6295\u5f71\u5254\u9664\u4e86\u884c\u4e3a\u8f74\u4e0a\u7684\u76f4\u63a5\u6536\u7f29\u9a71\u52a8\uff0c\u56e0\u6b64\u4e0d\u4f1a\u4ee5\u51cf\u5c0f\u4e24\u4e2a\u7801\u5b57\u5728\u884c\u4e3a\u65b9\u5411\u4e0a\u7684\u95f4\u8ddd\u4f5c\u4e3a\u4f18\u5316\u76ee\u6807\u3002\u4f46\u5b83\u4e0d\u80fd\u6570\u5b66\u4e0a\u4fdd\u8bc1\u5b8c\u6574\u6b27\u6c0f\u8ddd\u79bb\u4e0d\u4e0b\u964d\uff0c\u9700\u6d4b\u91cf\u5b9e\u9645\u7aef\u70b9\u7801\u5b57\u8ddd\u79bb\u5206\u5e03\u548c hard SID\u3002",
    "vs_r8": [
      {
