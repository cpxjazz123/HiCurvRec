  "differentiation": {
    "occupancy_preservation": "\u65b9\u5411\u9879\u63a8\u52a8\u76ee\u6807\u6700\u8fd1\u7801\u5b57 c_b \u671d\u884c\u4e3a\u6b8b\u5dee\u65b9\u5411\u79fb\u52a8\uff1b\u5206\u79bb\u5c4f\u969c\u5728\u6e90\u4e0e\u76ee\u6807\u6700\u8fd1\u7801\u5b57\u8ddd\u79bb\u5c0f\u4e8e margin \u65f6\u5c06\u4e8c\u8005\u63a8\u5f00\u3002\u65b9\u5411\u9879\u4e0d\u662f\u4e24\u4e2a\u7aef\u70b9\u7801\u5b57\u7684\u5438\u5f15\u9879\uff0c\u56e0\u6b64\u4e0d\u4ee5\u7aef\u70b9\u6536\u655b\u5b9e\u73b0\u884c\u4e3a\u5bf9\u9f50\uff1b\u6700\u8fd1\u90bb\u7d22\u5f15\u56fa\u5b9a\u4e8e\u5355\u6b21\u524d\u5411\uff0c\u66f4\u65b0\u540e\u7684\u6574\u4f53\u5206\u533a\u4ecd\u987b\u5b9e\u6d4b\u3002",
