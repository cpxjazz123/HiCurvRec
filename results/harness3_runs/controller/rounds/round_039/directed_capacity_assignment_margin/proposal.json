  "differentiation": {
    "occupancy_preservation": "\u8f6f\u91cd\u53e0\u9879\u5bf9\u6e90\u3001\u76ee\u6807\u53ca\u7801\u5b57\u5747\u4ea7\u751f\u68af\u5ea6\uff0c\u63a8\u52a8\u884c\u4e3a\u7aef\u70b9\u7684\u5206\u914d\u6982\u7387\u5728\u7801\u672c\u4e0a\u91cd\u53e0\uff1b\u5206\u79bb\u5c4f\u969c\u5728\u4e24\u4e2a\u7aef\u70b9\u6700\u8fd1\u7801\u5b57\u8ddd\u79bb\u5c0f\u4e8e margin \u65f6\u53cd\u5411\u63a8\u5f00\u8fd9\u4e24\u4e2a\u7801\u5b57\uff0c\u9632\u6b62\u628a\u914d\u5bf9\u517c\u5bb9\u5ea6\u7b80\u5355\u5b9e\u73b0\u4e3a\u7aef\u70b9\u7801\u5b57\u5408\u5e76\u3002\u8f6f\u5206\u914d\u91cd\u53e0\u4ecd\u53ef\u80fd\u4ee4\u5206\u914d\u8fb9\u754c\u79fb\u52a8\u6216\u95f4\u63a5\u9020\u6210\u5355\u5143\u4e0d\u5e73\u8861\uff0c\u4e0d\u80fd\u636e\u6b64\u4fdd\u8bc1\u5bb9\u91cf\u6216\u524d\u7f00\u6811\u4e0d\u53d8\u3002",
    "vs_r8": [
      {
