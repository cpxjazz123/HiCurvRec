  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u901a\u8fc7\u6e90\u4e0e\u76ee\u6807\u7684\u8f6f\u5206\u914d\u6982\u7387\u4f5c\u7528\u4e8e\u5168\u4f53\u7801\u5b57\uff0c\u5e76\u901a\u8fc7\u5e73\u5747\u8f6f\u4f7f\u7528\u7387\u60e9\u7f5a\u8fc7\u5ea6\u5360\u7528\uff1b\u4e0d\u5c06\u6210\u5bf9\u7801\u5b57\u4f5c\u663e\u5f0f\u5438\u5f15\u6216\u7f29\u77ed\u7aef\u70b9\u7801\u5b57\u8ddd\u79bb\u3002\u8f6f\u5bb9\u91cf\u6b63\u5219\u4ec5\u7ea6\u675f\u8f6f\u5e73\u5747\uff0c\u4e0d\u662f\u786c\u5bb9\u91cf\u4fdd\u8bc1\uff1b\u9000\u706b\u3001\u79bb\u6563\u91cf\u5316\u53ca\u6709\u9650\u8bad\u7ec3\u5747\u53ef\u80fd\u4ecd\u4ea7\u751f\u5927\u5c3e\u90e8 cell\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0e encoder-only \u60f0\u6027\u673a\u5236\u4e0d\u540c\uff0c\u672c\u9879\u76f4\u63a5\u5bf9\u8f6f\u5206\u914d\u6240\u4f9d\u8d56\u7684 codebook \u6c42\u5bfc\u3002\u4e0e\u574d\u584c\u7684\u7aef\u70b9\u4ea4\u53c9\u71b5\u4e0d\u540c\uff0c\u672c\u9879\u4e0d\u662f\u628a\u4e24\u4e2a\u7aef\u70b9\u5404\u81ea\u7684\u6700\u8fd1\u7801\u5b57\u5438\u5f15\u5230\u4e00\u8d77\uff0c\u800c\u662f\u4f18\u5316\u5206\u5e03\u91cd\u53e0\u5e76\u540c\u65f6\u5bf9\u5168\u5c40\u8f6f\u5360\u7528\u65bd\u52a0\u5747\u8861\u7ea6\u675f\uff1b\u4f46\u5b83\u53ef\u80fd\u56e0\u8f6f\u5230\u786c\u5dee\u5f02\u800c\u5728\u8bad\u7ec3\u540e\u4ecd\u5408\u5e76 cell\u3002"
      }
    ],
    "vs_reference_arm": "the reference arm is the untouched host; this candidate adds one term whose gradient reaches the codebook without pulling a transition's two codewords together"
  },
  "equation": "\u5bf9\u6bcf\u4e2a x\u2208{source_b,target_b} \u5b9a\u4e49 p_xc = softmax_c(-||x-codebook_c||_2^2 / temperature)\u3002\u4ee4 q_b = p_source_b\uff0cr_b = p_target_b\uff0c\u4e14\u4ee4 \u03c0_c = mean_{b:mask_b=1} q_bc\u3002\u5b9a\u4e49 L = lambda * masked_mean_b[ -log(sum_c q_bc * r_bc + eps) + capacity_weight * sum_c (\u03c0_c - 1/C)^2 + direction_weight * sum_c (q_bc-r_bc) * (||target_b-codebook_c||_2^2-||source_b-codebook_c||_2^2) ]\u3002",
  "expected_failure_modes": [
