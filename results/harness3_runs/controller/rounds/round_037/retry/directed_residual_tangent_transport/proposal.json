  "differentiation": {
    "occupancy_preservation": "\u5207\u7a7a\u95f4\u6b8b\u5dee\u9879\u63a8\u52a8\u7801\u5b57\u914d\u7f6e\u9002\u914d\u6709\u5411\u884c\u4e3a\u6b8b\u5dee\u51e0\u4f55\uff1b\u95f4\u9694 hinge \u5bf9\u4f4e\u4e8e\u6700\u5c0f\u8ddd\u79bb m \u7684\u6e90\u7aef/\u76ee\u6807\u7aef\u6700\u8fd1\u7801\u5b57\u65bd\u52a0\u6392\u65a5\u68af\u5ea6\uff0c\u8ddd\u79bb\u8fbe\u5230 m \u540e\u68af\u5ea6\u4e3a\u96f6\u3002\u8be5\u9879\u4e0d\u4f1a\u628a\u884c\u4e3a\u5bf9\u7684\u4e24\u7801\u5b57\u62c9\u8fd1\uff0c\u4e14\u5bf9\u8ddd\u79bb\u4e0d\u8db3\u7684 pair \u660e\u786e\u65bd\u52a0\u9632\u6536\u655b\u4f5c\u7528\uff1b\u79bb\u6563\u6700\u8fd1\u7801\u5b57\u7d22\u5f15\u7684\u9009\u62e9\u672c\u8eab\u4e0d\u53ef\u5fae\uff0c\u68af\u5ea6\u53ea\u7ecf\u8fde\u7eed\u76f8\u4f3c\u5ea6\u3001\u6295\u5f71\u4e0e\u8ddd\u79bb\u9879\u4f20\u64ad\u3002",
    "vs_r8": [
