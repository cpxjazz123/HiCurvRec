  "differentiation": {
    "occupancy_preservation": "\u8f6f\u5171\u5206\u914d\u9879\u5c06\u884c\u4e3a\u8fb9\u4e24\u7aef\u7684\u6982\u7387\u8d28\u91cf\u6295\u5411\u5171\u540c\u7801\u5b57\uff0c\u4ece\u800c\u6539\u53d8 Voronoi \u5206\u533a\uff1b\u5206\u79bb\u5c4f\u969c\u5728\u4e24\u7aef\u6700\u8fd1\u7801\u5b57\u8ddd\u79bb\u4f4e\u4e8e min_separation \u65f6\u65bd\u52a0\u6392\u65a5\u68af\u5ea6\uff0c\u660e\u786e\u963b\u6b62\u7aef\u70b9\u7801\u5b57\u5408\u5e76\u3002\u5bb9\u91cf\u5e73\u8861\u4e0d\u7531\u6b64\u516c\u5f0f\u4fdd\u8bc1\uff0c\u5fc5\u987b\u5728\u51b7\u8fd0\u884c\u68c0\u67e5 Gini\u3001\u5728\u7528\u7801\u6570\u548c\u5206\u652f\u6570\u3002",
    "vs_r8": [
