  "differentiation": {
    "occupancy_preservation": "\u635f\u5931\u4ec5\u901a\u8fc7\u6700\u8fd1\u7801\u5b57\u7684\u53ef\u5fae\u53d6\u503c\u4ea7\u751f\u7801\u672c\u68af\u5ea6\uff0c\u63a8\u52a8\u76ee\u6807\u76f8\u5bf9\u6e90\u7801\u5b57\u6cbf\u6e90\u91cf\u5316\u65b9\u5411\u6b63\u4ea4\u7684\u884c\u4e3a\u5207\u5411\u91cf\u6ee1\u8db3\u95f4\u9694\u3002\u5b83\u4e0d\u6700\u5c0f\u5316\u6e90\u3001\u76ee\u6807\u7801\u5b57\u8ddd\u79bb\uff0c\u4e5f\u4e0d\u628a\u4e24\u8005\u62c9\u5411\u5f7c\u6b64\uff1b\u4e24\u7801\u5b57\u53ef\u4fdd\u6301\u5206\u79bb\uff0c\u751a\u81f3\u6cbf\u5207\u5411\u91cd\u65b0\u5b9a\u5411\u3002\u6700\u8fd1\u7801\u5b57\u7d22\u5f15\u5904\u4e0d\u53ef\u5fae\uff0c\u6545\u5b9e\u9645\u68af\u5ea6\u53ea\u66f4\u65b0\u88ab\u9009\u4e2d\u7684\u7801\u5b57\u884c\u3002",
