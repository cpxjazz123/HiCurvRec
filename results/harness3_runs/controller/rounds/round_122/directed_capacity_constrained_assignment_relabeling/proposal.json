  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u7ecf p_s \u5bf9\u6e90\u7aef\u6700\u8fd1\u7ade\u4e89\u7801\u5b57\u7684\u5206\u914d\u6982\u7387\u4f5c\u7528\u4e8e\u7801\u5b57\uff0c\u5e76\u7531 batch \u5bb9\u91cf\u9879\u62b5\u6d88\u5355\u4e00\u4ee3\u7801\u88ab\u8fc7\u5ea6\u5360\u7528\u7684\u503e\u5411\u3002\u76ee\u6807\u7aef\u6982\u7387\u505c\u6b62\u68af\u5ea6\uff0c\u56e0\u6b64\u4e0d\u4f1a\u901a\u8fc7\u540c\u65f6\u62c9\u52a8\u4e24\u4e2a\u7aef\u70b9\u7801\u5b57\u6765\u964d\u4f4e\u8f6c\u79fb\u635f\u5931\uff1b\u8be5\u9879\u4f18\u5316\u7684\u662f\u6709\u5411\u5206\u914d\u6982\u7387\u800c\u975e\u7aef\u70b9\u7801\u5b57\u95f4\u8ddd\u3002\u5bb9\u91cf\u9879\u53ea\u662f batch \u8f6f\u5bb9\u91cf\u5747\u8861\uff0c\u4e0d\u4fdd\u8bc1\u786c SID \u7684\u6700\u5927 cell\u3001\u524d\u7f00\u5bbd\u5ea6\u6216\u51b7\u8fd0\u884c\u5bb9\u91cf\u4e25\u683c\u4e0d\u53d8\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u662f\u4ec5\u4f5c\u7528\u4e8e\u7f16\u7801\u5668\u7684\u8f85\u52a9\u9879\uff1a\u6e90\u7aef\u68af\u5ea6\u4e4b\u5916\uff0c\u7801\u672c\u4e5f\u901a\u8fc7\u8f6f\u5206\u914d\u6982\u7387\u548c\u5bb9\u91cf\u9879\u83b7\u5f97\u68af\u5ea6\u3002\u4e5f\u4e0d\u662f\u628a pair \u4e24\u7aef\u7801\u5b57\u5171\u540c\u5438\u5f15\u5230\u4e00\u8d77\u7684 pairwise loss\uff1a\u76ee\u6807\u5206\u914d\u505c\u6b62\u68af\u5ea6\uff0c\u4e14\u5747\u8861\u9879\u4f5c\u7528\u4e8e\u7fa4\u4f53\u5360\u7528\u6982\u7387\u800c\u975e\u7aef\u70b9\u8ddd\u79bb\u3002\u4ecd\u987b\u68c0\u67e5\u51b7\u5bfc\u51fa\u662f\u5426\u53d1\u751f\u786c\u5bb9\u91cf\u96c6\u4e2d\u3002"
      }
    ],
    "vs_reference_arm": "the reference arm is the untouched host; this candidate adds one term whose gradient reaches the codebook without pulling a transition's two codewords together"
  },
  "equation": "\u4ee4 p_s(c)=softmax(-||source-c||\u00b2/tau)\uff0cp_t(c)=softmax(-||target-c||\u00b2/tau)\uff0cq(c)=softmax(-||source-c||\u00b2/tau)\u3002\u5bf9\u6bcf\u4e2a\u6709\u6548\u5bf9\u5b9a\u4e49 L_i = -log(sum_c p_s(c) * stopgrad(p_t(c))) + balance_weight * sum_c (mean_mask(q(c)) - 1/C)^2\u3002\u603b\u635f\u5931\u4e3a weight * masked_mean(L_i)\u3002\u5b9e\u9645\u5b9e\u73b0\u4e2d\uff0c\u7b2c\u4e8c\u9879\u7684 q \u6309\u5f53\u524d\u6709\u6548 batch \u8ba1\u7b97\uff1b\u7a7a\u63a9\u7801\u65f6\u603b\u635f\u5931\u4e25\u683c\u4e3a\u96f6\u3002",
  "expected_failure_modes": [
    "\u8f6f\u5206\u914d\u7684 batch \u5747\u8861\u53ef\u80fd\u4e0e\u771f\u5b9e\u5168\u76ee\u5f55\u786c\u5206\u914d\u4e0d\u4e00\u81f4\uff0c\u4e14\u8f83\u4f4e\u6e29\u5ea6\u53ef\u80fd\u4ea7\u751f\u7a00\u758f\u3001\u5c16\u9510\u68af\u5ea6\u3002\u6e90\u7aef\u8ffd\u968f\u76ee\u6807\u7aef\u8f6f\u5206\u914d\u53ef\u80fd\u63d0\u9ad8\u8f6c\u79fb\u5171\u4eab\u6982\u7387\uff0c\u5374\u727a\u7272\u786c\u5206\u914d\u4e0b\u7684\u6700\u5927 cell\u3001\u6d3b\u8dc3\u7801\u6570\u3001\u524d\u7f00\u5206\u652f\u6216\u5e8f\u5217\u4fe1\u606f\uff1b\u5373\u4f7f ER \u8fc7\u95e8\u4e5f\u53ef\u80fd\u964d\u4f4e Stage-3\u3002\u56e0\u6b64\u9700\u6309\u51b7\u8fd0\u884c\u7ed3\u679c\u5224\u65ad\uff0c\u4e0d\u7528\u77ed\u63a2\u9488\u7684 ER \u6216\u5e73\u8861\u62d2\u7edd\u5019\u9009\u3002"
