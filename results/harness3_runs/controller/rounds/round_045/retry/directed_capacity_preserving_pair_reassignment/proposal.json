  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u6539\u53d8\u6765\u6e90\u5bf9\u5404\u4ee3\u7801\u7684\u76f8\u5bf9\u8ddd\u79bb\u53ca\u8f6f\u5206\u914d\uff0c\u4e0d\u542b\u628a\u6765\u6e90\u3001\u76ee\u6807\u6620\u5c04\u5230\u540c\u4e00\u4ee3\u7801\u7684\u663e\u5f0f\u5438\u5f15\u9879\uff1b\u901a\u8fc7\u76ee\u6807\u6761\u4ef6\u91cd\u5206\u914d\u5f71\u54cd\u5206\u7ec4\u3002\u6709\u9650\u6279\u6b21\u7684\u8f6f\u5bb9\u91cf\u6b63\u5219\u4e0d\u80fd\u4fdd\u8bc1\u786c SID \u5355\u5143\u5bb9\u91cf\u4e0d\u53d8\uff0c\u5fc5\u987b\u6d4b\u91cf\u6700\u5927\u5355\u5143\u548c\u5728\u7528\u4ee3\u7801\u6570\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u533a\u522b\u4e8e\u53ea\u4f20\u9012\u7f16\u7801\u5668\u68af\u5ea6\u7684\u60f0\u6027\u9879\uff0c\u672c\u9879\u58f0\u660e\u5e76\u8981\u6c42\u4ee3\u7801\u672c\u68af\u5ea6\u975e\u96f6\u3002\u533a\u522b\u4e8e\u4ea4\u53c9\u71b5\u76f4\u63a5\u8ba9\u4e00\u5bf9\u7aef\u70b9\u5171\u7528\u4ee3\u7801\u800c\u5bfc\u81f4\u4ee3\u7801\u5b57\u6536\u655b\u7684\u574d\u7f29\u9879\uff0c\u672c\u9879\u7684\u76ee\u6807\u662f\u6709\u5411\u5206\u914d\u91cd\u6392\u800c\u975e\u7aef\u70b9\u914d\u5bf9\u5438\u5f15\uff1b\u4e0d\u8fc7\u5bb9\u91cf\u4fdd\u6301\u53ea\u662f\u673a\u5236\u8bbe\u8ba1\u76ee\u6807\uff0c\u4e0d\u4f5c\u4e3a\u672a\u7ecf\u6d4b\u91cf\u7684\u4fdd\u8bc1\u3002"
      }
