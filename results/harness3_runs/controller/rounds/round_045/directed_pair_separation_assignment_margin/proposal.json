  "differentiation": {
    "occupancy_preservation": "\u8f6f\u5171\u4eab\u7801\u9879\u63a8\u52a8\u6b63\u5411\u914d\u5bf9\u589e\u52a0\u540c\u7801\u6982\u7387\uff0c\u53cd\u5411\u9879\u4fdd\u7559\u65b9\u5411\u6027\uff1b\u72ec\u7acb\u7684\u77ed\u8ddd\u79bb\u6307\u6570\u6392\u65a5\u9879\u5728\u7aef\u70b9\u6700\u8fd1\u7801\u5b57\u76f8\u540c\u7684\u60c5\u5f62\u5916\u963b\u6b62\u7801\u5b57\u95f4\u8ddd\u8fc7\u5c0f\u3002\u8be5\u7ea6\u675f\u4e0d\u5f3a\u5236\u5168\u5c40\u5bb9\u91cf\uff0c\u4e5f\u4e0d\u4fdd\u8bc1\u786c\u5206\u914d\u7684\u5355\u5143\u5927\u5c0f\u6216\u524d\u7f00\u6811\u4e0d\u53d8\u3002",
