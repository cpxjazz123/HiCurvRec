  "differentiation": {
    "occupancy_preservation": "\u65b9\u5411\u6027\u91cf\u5316\u95f4\u9694\u9879\u63a8\u52a8\u76ee\u6807\u8868\u793a\u66f4\u9002\u914d\u5176\u6700\u8fd1\u7801\u5b57\u800c\u975e\u6e90\u9879\u6700\u8fd1\u7801\u5b57\uff1b\u914d\u5bf9\u95f4\u9694\u9879\u4ec5\u5f53\u4e24\u7801\u5b57\u8ddd\u79bb\u4f4e\u4e8e minimum_gap \u65f6\u6cbf\u4e24\u7801\u5b57\u8fde\u7ebf\u65bd\u52a0\u53cd\u5411\u68af\u5ea6\uff0c\u7edd\u4e0d\u56e0\u6b63\u914d\u5bf9\u672c\u8eab\u7f29\u77ed c_s \u4e0e c_t \u7684\u8ddd\u79bb\u3002\u5176\u51e0\u4f55\u65b9\u5411\u4e0e\u6700\u8fd1\u90bb\u5355\u5143\u8fb9\u754c\u6709\u5173\uff0c\u53ef\u80fd\u6539\u53d8\u5206\u7ec4\uff0c\u4f46\u6ca1\u6709\u627f\u8bfa ER \u6216\u4e0b\u6e38\u7ed3\u679c\u5fc5\u7136\u63d0\u5347\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0e\u4ec5\u4f5c\u7528\u4e8e encoder \u7684\u60f0\u6027\u9879\u4e0d\u540c\uff0c\u672c\u9879\u660e\u786e\u5bf9\u6700\u8fd1\u7801\u5b57\u884c\u4ea7\u751f\u68af\u5ea6\uff0c\u56e0\u800c\u4e0d\u4f9d\u8d56\u5df2\u88ab\u4e3b\u673a\u8986\u76d6\u7684 encoder \u68af\u5ea6\u3002\u4e0e\u5bfc\u81f4\u574d\u7f29\u7684\u914d\u5bf9\u4ea4\u53c9\u71b5\u4e0d\u540c\uff0c\u672c\u9879\u6ca1\u6709\u62c9\u8fd1\u6b63\u914d\u5bf9\u4e24\u7aef\u7801\u5b57\u7684\u5438\u5f15\u9879\uff0c\u4e14\u4f4e\u4e8e\u95f4\u9694\u9608\u503c\u65f6\u65bd\u52a0\u6392\u65a5\uff1b\u4f46\u5b83\u4ecd\u53ef\u80fd\u79fb\u52a8 Voronoi \u8fb9\u754c\uff0c\u6545\u4e0d\u628a\u4e0d\u574d\u7f29\u8bef\u79f0\u4e3a\u4e0b\u6e38\u6210\u529f\u3002"
