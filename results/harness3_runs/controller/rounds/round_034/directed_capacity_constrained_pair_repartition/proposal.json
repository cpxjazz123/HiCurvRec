  "differentiation": {
    "occupancy_preservation": "\u914d\u5bf9\u8f6f\u5171\u5206\u914d\u9879\u6cbf\u4e24\u8868\u793a\u5230\u5404\u7801\u5b57\u7684\u8ddd\u79bb\u68af\u5ea6\u63a8\u52a8\u5171\u5206\u914d\u6982\u7387\u4e0a\u5347\uff1b\u6279\u6b21\u8fb9\u9645 KL \u9879\u63a8\u52a8\u5e73\u5747\u8f6f\u4f7f\u7528\u5206\u5e03\u63a5\u8fd1\u5747\u5300\u3002\u5747\u8861\u9879\u662f\u5bf9\u7801\u5b57\u603b\u4f53\u4f7f\u7528\u7387\u7684\u7ed3\u6784\u7ea6\u675f\uff0c\u4e0d\u662f\u628a\u5355\u4e2a\u914d\u5bf9\u7684\u4e24\u4e2a\u6700\u8fd1\u7801\u5b57\u62c9\u5230\u4e00\u8d77\u7684\u8ddd\u79bb\u5438\u5f15\u9879\uff1b\u7136\u800c\u5171\u5206\u914d\u9879\u672c\u8eab\u53ef\u80fd\u4ee4\u914d\u5bf9\u8de8\u8d8a Voronoi \u8fb9\u754c\uff0c\u4e0d\u80fd\u4fdd\u8bc1\u786c\u5206\u914d\u4e2d\u7801\u5b57\u95f4\u8ddd\u4e0d\u53d8\u3002",
    "vs_r8": [
      {
