  "differentiation": {
    "occupancy_preservation": "\u5bf9\u6700\u8fd1\u76ee\u6807\u7801\u5b57\u65bd\u52a0\u5207\u5411\u5206\u91cf\u800c\u975e\u6cbf source-target \u8fde\u7ebf\u62c9\u8fd1\u4e24\u7aef\u7801\u5b57\uff1b\u6700\u8fd1\u7801\u5b57\u8ddd\u79bb\u969c\u788d\u53ea\u5728\u8ddd\u79bb\u4f4e\u4e8e sep \u65f6\u4ea7\u751f\u6392\u65a5\u68af\u5ea6\uff0c\u963b\u6b62\u7801\u5b57\u5bf9\u6536\u655b\u3002\u5b83\u4e0d\u4fdd\u8bc1\u771f\u5b9e\u8bad\u7ec3\u4e2d\u4e0d\u4f1a\u53d1\u751f\u5176\u4ed6\u95f4\u63a5\u5408\u5e76\uff0c\u5fc5\u987b\u7531\u51b7\u8dd1\u5bfc\u51fa\u68c0\u67e5\u9a8c\u8bc1\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u540c\u4e8e\u53ea\u4f5c\u7528\u4e8e encoder\u3001\u88ab\u5bbf\u4e3b\u8986\u76d6\u800c\u5b8c\u5168\u60f0\u6027\u7684\u9879\uff0c\u6b64\u76ee\u6807\u660e\u786e\u8981\u6c42 codebook \u68af\u5ea6\u975e\u96f6\uff1b\u4e0d\u540c\u4e8e\u5c06\u884c\u4e3a\u5bf9\u4e24\u7aef\u7801\u5b57\u76f4\u63a5\u62c9\u8fd1\u7684\u635f\u5931\uff0c\u5b83\u4ee5\u5207\u5411\u7801\u5b57\u8fd0\u52a8\u6539\u53d8\u5206\u7ec4\uff0c\u5e76\u663e\u5f0f\u5bf9\u8fc7\u8fd1\u7801\u5b57\u65bd\u52a0\u6392\u65a5\u3002\u4f46\u6392\u65a5\u53ea\u7ea6\u675f\u8be5\u516c\u5f0f\u9009\u51fa\u7684\u8fd1\u90bb\uff0c\u4e0d\u80fd\u636e\u6b64\u9884\u5148\u58f0\u79f0\u51b7\u8dd1\u5fc5\u7136\u4fdd\u6301\u5206\u533a\u3002"
      }
