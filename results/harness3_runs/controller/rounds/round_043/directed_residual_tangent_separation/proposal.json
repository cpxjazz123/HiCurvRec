  "differentiation": {
    "occupancy_preservation": "\u65b9\u5411\u5bf9\u9f50\u9879\u6cbf\u884c\u4e3a\u6b8b\u5dee\u6539\u53d8\u6e90\u5355\u5143\u7684\u7801\u672c\u51e0\u4f55\uff1b\u5206\u79bb\u5c4f\u969c\u9879\u5728\u7aef\u70b9\u7801\u5b57\u8ddd\u79bb\u5c0f\u4e8e margin \u65f6\u63d0\u4f9b\u6392\u65a5\u68af\u5ea6\uff0c\u8ddd\u79bb\u8fbe\u5230\u8fb9\u754c\u540e\u4e3a\u96f6\u3002\u6545\u5bf9\u88ab\u8be5\u9879\u5b9e\u9645\u9009\u4e2d\u7684\u7aef\u70b9\u7801\u5b57\uff0c\u5b83\u963b\u6b62\u7ee7\u7eed\u9760\u62e2\u800c\u4e0d\u662f\u5438\u5f15\u5b83\u4eec\uff1b\u672a\u9009\u4e2d\u7801\u5b57\u3001\u6709\u9650\u4f18\u5316\u6b65\u957f\u548c\u5176\u4ed6\u8bad\u7ec3\u635f\u5931\u4ecd\u53ef\u80fd\u9020\u6210\u5408\u5e76\u3002",
