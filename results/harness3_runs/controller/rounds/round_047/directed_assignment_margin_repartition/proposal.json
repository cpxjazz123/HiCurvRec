  "differentiation": {
    "occupancy_preservation": "\u524d\u4e24\u9879\u901a\u8fc7\u4e24\u7aef\u5404\u81ea\u7684\u8f6f\u5206\u914d\u6982\u7387\u66f4\u65b0\u7801\u5b57\u4ee5\u6539\u53d8\u5206\u7ec4\uff1b\u95f4\u9694\u60e9\u7f5a\u5728\u8f6f\u5206\u914d\u7aef\u70b9\u7801\u5411\u91cf\u8ddd\u79bb\u4f4e\u4e8e margin \u65f6\u4ea7\u751f\u5206\u79bb\u68af\u5ea6\uff0c\u53cd\u5bf9\u7aef\u70b9\u7801\u5411\u91cf\u6c47\u5408\u3002\u6b64\u8f6f\u95f4\u9694\u4e0d\u4fdd\u8bc1\u786c SID \u4e00\u5b9a\u5206\u79bb\uff0c\u4e5f\u4e0d\u4fdd\u8bc1\u6574\u4f53\u7ec6\u80de\u5bb9\u91cf\u4e0d\u53d8\uff0c\u5fc5\u987b\u5b9e\u6d4b\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u662f\u4ec5\u4f5c\u7528\u4e8e\u7f16\u7801\u5668\u7684\u9879\uff0c\u56e0\u4e3a\u8f6f\u5206\u914d\u663e\u5f0f\u4f9d\u8d56\u53ef\u8bad\u7ec3\u7801\u672c\uff1b\u4e0d\u662f\u628a\u540c\u4e00\u7801\u5b57\u540c\u65f6\u62c9\u5411\u884c\u4e3a\u5bf9\u4e24\u7aef\u7684\u4ea4\u53c9\u71b5\uff0c\u56e0\u4e3a\u65b9\u5411\u6027\u91cd\u5206\u914d\u9879\u4e4b\u5916\u8fd8\u52a0\u5165\u4e86\u7aef\u70b9\u8f6f\u7801\u5411\u91cf\u95f4\u9694\u60e9\u7f5a\uff0c\u76f4\u63a5\u53cd\u5bf9 pair convergence\u3002"
      }
