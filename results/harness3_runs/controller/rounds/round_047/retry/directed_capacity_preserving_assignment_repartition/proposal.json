  "differentiation": {
    "occupancy_preservation": "\u5171\u7801\u6982\u7387\u9879\u63a8\u52a8\u884c\u4e3a\u5bf9\u843d\u5165\u540c\u4e00\u5206\u914d\u533a\u57df\uff1b\u8fd1\u7801\u5b57\u60e9\u7f5a\u9879\u5bf9\u5171\u4eab\u6982\u7387\u9ad8\u4e14\u5f7c\u6b64\u63a5\u8fd1\u7684\u7801\u5b57\u65bd\u52a0\u5206\u79bb\u68af\u5ea6\uff0c\u907f\u514d\u4ee5\u4e24\u4e2a\u76f8\u5173\u7801\u5b57\u6536\u655b\u6765\u63d0\u9ad8\u5339\u914d\u7387\u3002\u8be5\u60e9\u7f5a\u4e0d\u662f\u786c\u7ea6\u675f\uff0c\u987b\u76f4\u63a5\u6d4b\u91cf pair codeword \u8ddd\u79bb\u3001\u6700\u5927\u5355\u5143\u53ca\u5206\u533a\u5bb9\u91cf\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u540c\u4e8e\u4ec5\u5bf9 encoder \u8d77\u4f5c\u7528\u7684\u5df2\u60f0\u6027\u673a\u5236\uff0c\u672c\u9879\u76f4\u63a5\u4ee5 codebook \u8ba1\u7b97\u8f6f\u5206\u914d\u5e76\u4f20\u9012\u68af\u5ea6\uff1b\u4e0d\u540c\u4e8e\u66fe\u5bfc\u81f4\u4e24\u7aef\u7801\u5b57\u6536\u655b\u7684 directed code assignment cross-entropy\uff0c\u672c\u9879\u5728\u5171\u7801\u6982\u7387\u4e4b\u5916\u663e\u5f0f\u52a0\u5165\u76f8\u8fd1\u7801\u5b57\u6392\u65a5\uff0c\u5e76\u4ee5 assignment \u7ed3\u6784\u4e3a\u76ee\u6807\u3002\u60e9\u7f5a\u80fd\u5426\u963b\u6b62\u5b9e\u9645\u5408\u5e76\u5c1a\u5f85\u6d4b\u91cf\u3002"
      }
