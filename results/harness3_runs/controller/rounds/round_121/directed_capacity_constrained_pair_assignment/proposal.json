  "differentiation": {
    "occupancy_preservation": "\u6392\u5e8f\u9879\u628a target \u8868\u5f81\u76f8\u5bf9\u5730\u62c9\u5411 c_t\u3001\u63a8\u79bb c_s\uff0c\u4e0d\u5305\u542b\u628a c_s \u4e0e c_t \u62c9\u8fd1\u7684\u6b63\u5411\u5438\u5f15\u9879\uff1b\u95f4\u8ddd\u5c4f\u969c\u5728\u4e24\u7801\u5b57\u8fc7\u8fd1\u65f6\u6392\u65a5\u4e8c\u8005\u3002\u5b83\u6539\u53d8 assignment \u7684\u6709\u5411\u7ed3\u6784\uff0c\u800c\u4e0d\u662f\u8981\u6c42\u4e00\u5bf9\u5171\u4eab\u7801\u5b57\u3002\u82e5 source \u4e0e target \u539f\u672c\u5df2\u5171\u4eab\u540c\u4e00\u7801\u5b57\uff0c\u6700\u8fd1\u884c\u76f8\u540c\uff0c\u5c4f\u969c\u5bf9\u8be5\u5bf9\u7684\u9632\u5408\u5e76\u80fd\u529b\u6709\u9650\u3002",
