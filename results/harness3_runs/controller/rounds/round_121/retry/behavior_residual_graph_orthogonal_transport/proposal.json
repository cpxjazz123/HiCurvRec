  "differentiation": {
    "occupancy_preservation": "\u68af\u5ea6\u4f9d\u636e\u505c\u6b62\u68af\u5ea6\u7684\u6b8b\u5dee\u5dee\u65b9\u5411\uff0c\u6539\u53d8\u4e2d\u5fc3\u5316\u7801\u5b57\u5728\u8be5\u65b9\u5411\u4e0a\u7684\u6295\u5f71\uff1b\u4e2d\u5fc3\u5316\u5f62\u5f0f\u6d88\u9664\u6574\u4f53\u5e73\u79fb\u81ea\u7531\u5ea6\u3002\u76ee\u6807\u51fd\u6570\u4e0d\u542b ||c_s-c_t|| \u7684\u5438\u5f15\u9879\uff0c\u4e0d\u4f1a\u76f4\u63a5\u7f29\u77ed\u914d\u5bf9\u7801\u5b57\u95f4\u8ddd\uff1b\u7531\u4e8e\u7d22\u5f15\u91cd\u5206\u914d\u53ca\u6295\u5f71\u9879\u4ecd\u53ef\u80fd\u95f4\u63a5\u6539\u53d8\u8ddd\u79bb\uff0c\u9700\u68c0\u67e5\u51b7\u8dd1\u914d\u5bf9\u95f4\u8ddd\u548c\u786c SID\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u540c\u4e8e\u4ec5\u4f5c\u7528\u4e8e encoder\u3001\u6700\u7ec8\u88ab\u4e3b\u673a\u8986\u76d6\u7684\u9879\uff0c\u672c\u673a\u5236\u660e\u786e\u4ea7\u751f codebook \u68af\u5ea6\uff1b\u4e0d\u540c\u4e8e\u4ea4\u53c9\u71b5\u628a\u4e00\u5bf9\u884c\u4e3a\u7aef\u70b9\u6c47\u5165\u540c\u4e00\u7801\u5b57\uff0c\u672c\u9879\u53ea\u7ea6\u675f\u7531\u6b8b\u5dee\u56fe\u65b9\u5411\u6d4b\u5f97\u7684\u4e2d\u5fc3\u5316\u7801\u5b57\u6295\u5f71\uff0c\u4e0d\u8bbe\u7f6e\u7aef\u70b9\u7801\u5b57\u95f4\u5438\u5f15\u529b\u3002\u5b83\u4ecd\u53ef\u80fd\u7ecf\u7531\u8bad\u7ec3\u52a8\u529b\u5b66\u95f4\u63a5\u9020\u6210\u5408\u5e76\uff0c\u5fc5\u987b\u4ee5\u68af\u5ea6\u4e0e\u5bfc\u51fa\u6d4b\u91cf\u9a8c\u8bc1\u3002"
      }
