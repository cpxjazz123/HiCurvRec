    "vs_reference_arm": "the reference arm is the untouched host; this candidate adds one term whose gradient reaches the codebook without pulling a transition's two codewords together"
  },
  "equation": "\u5bf9\u6bcf\u4e2a\u6709\u6548\u8f6c\u79fb i\uff0c\u4ee4 p_i(c) = softmax_c(-||source_i-c_c||_2^2 / tau)\uff0cq_i(c) = softmax_c(-||target_i-c_c||_2^2 / tau)\uff0c\u5e76\u4ee4 r_i(c) = p_i(c) q_i(c)\u3002\u4ee4 m(c) = mean_i[p_i(c)]\uff0cs(c) = mean_i[r_i(c)]\u3002\u5b9a\u4e49 L = weight * [ -mean_i log(eps + sum_c r_i(c)) + lambda * sum_c (s(c)-m(c))^2 / (m(c)+eps) ]\u3002\u7b2c\u4e00\u9879\u5956\u52b1\u884c\u4e3a\u8f6c\u79fb\u4e24\u7aef\u5171\u4eab\u5206\u533a\uff0c\u7b2c\u4e8c\u9879\u7ea6\u675f\u884c\u4e3a\u914d\u5bf9\u9020\u6210\u7684\u5355\u5143\u4f7f\u7528\u504f\u79fb\uff1b\u8be5\u76ee\u6807\u4e0d\u901a\u8fc7\u76f4\u63a5\u7f29\u77ed\u7801\u5b57\u95f4\u8ddd\u6765\u5b9e\u73b0\u5171\u4eab\u3002",
  "expected_failure_modes": [
