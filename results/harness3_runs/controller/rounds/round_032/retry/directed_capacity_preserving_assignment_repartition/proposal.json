  "differentiation": {
    "occupancy_preservation": "\u4ee5\u8f6f\u5206\u914d\u6982\u7387\u7684\u4e58\u79ef\u9f13\u52b1\u884c\u4e3a\u5bf9\u8fdb\u5165\u5171\u540c\u5355\u5143\uff0c\u5e76\u4ee5\u76f8\u5bf9\u8fb9\u9645\u504f\u79fb\u60e9\u7f5a\u6291\u5236\u5355\u5143\u4f7f\u7528\u7387\u91cd\u65b0\u5206\u914d\uff1b\u5bf9\u7801\u5b57\u7684\u68af\u5ea6\u6765\u81ea\u5206\u914d\u8fb9\u754c\u79fb\u52a8\uff0c\u4e0d\u5305\u542b\u8ba9\u4e00\u5bf9\u7801\u5b57\u5f7c\u6b64\u9760\u8fd1\u7684\u8ddd\u79bb\u6700\u5c0f\u5316\u9879\u3002\u5b83\u4e0d\u4fdd\u8bc1\u5b9e\u9645\u79bb\u6563\u5355\u5143\u5927\u5c0f\u5b8c\u5168\u4e0d\u53d8\uff0c\u987b\u7531\u51b7\u8fd0\u884c\u7684\u5360\u7528\u3001Gini\u3001\u5206\u652f\u6570\u53ca\u6f02\u79fb\u6307\u6807\u68c0\u9a8c\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0d\u540c\u4e8e\u7eaf\u7f16\u7801\u5668\u8f85\u52a9\u9879\uff0c\u672c\u9879\u901a\u8fc7\u5206\u914d\u6982\u7387\u4f9d\u8d56\u7801\u672c\uff0c\u5fc5\u987b\u5b9e\u6d4b\u5176\u7801\u672c\u68af\u5ea6\uff1b\u4e0d\u540c\u4e8e\u5b9a\u5411\u4ea4\u53c9\u71b5\u628a\u4e24\u7aef\u62c9\u5411\u540c\u4e00\u7801\u5b57\u5e76\u5bfc\u81f4\u4e24\u7801\u5408\u5e76\uff0c\u672c\u9879\u4f18\u5316\u8f6f\u5206\u914d\u7ed3\u6784\u53ca\u8fb9\u9645\u4f7f\u7528\u504f\u79fb\uff0c\u4e0d\u542b\u7801\u5b57\u95f4\u8ddd\u6536\u7f29\u9879\uff0c\u4f46\u662f\u5426\u5b9e\u73b0\u5bb9\u91cf\u4fdd\u6301\u7531\u51b7\u8fd0\u884c\u5b9e\u6d4b\u800c\u975e probe \u63a8\u65ad\u3002"
      }
