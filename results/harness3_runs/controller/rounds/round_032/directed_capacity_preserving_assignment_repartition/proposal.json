  "differentiation": {
    "occupancy_preservation": "\u5bf9\u6240\u6709\u8f6f\u5206\u914d\u4ee3\u7801\u5b57\u5bf9\u65bd\u52a0\u4f9d\u884c\u4e3a\u65b9\u5411\u7684\u4ee3\u4ef7\uff0c\u5e76\u5bf9\u6b63\u6837\u672c\u4e24\u7aef\u4ee3\u7801\u5b57\u95f4\u9694\u4e0d\u8db3\u65bd\u52a0\u6392\u65a5\uff1b\u68af\u5ea6\u4f5c\u7528\u4e8e codebook\uff0c\u800c\u4e0d\u662f\u53ea\u6539 encoder\u3002\u5b83\u5c1d\u8bd5\u6539\u53d8\u54ea\u4e9b\u884c\u4e3a\u7aef\u70b9\u5206\u914d\u5230\u54ea\u4e9b\u7801\u5b57\uff0c\u4e0d\u901a\u8fc7\u7f29\u77ed\u6b63\u6837\u672c\u4ee3\u7801\u5b57\u8ddd\u79bb\u63d0\u5347\u76ee\u6807\u3002\u8f6f\u5206\u914d\u6e29\u5ea6\u53ef\u80fd\u8fc7\u9ad8\u800c\u5bfc\u81f4\u68af\u5ea6\u7a00\u91ca\uff0c\u6216\u8fc7\u4f4e\u800c\u9000\u5316\u4e3a\u786c\u5206\u914d\u8fd1\u4f3c\u3002",
