    "occupancy_preservation": "\u8be5\u76ee\u6807\u7ea6\u675f\u884c\u4e3a\u5bf9\u4e24\u7aef\u7684\u6b8b\u5dee\u53d8\u5316\uff0c\u5e76\u4f7f\u76ee\u6807\u4ee3\u7801\u5b57\u4f4d\u79fb\u6cbf\u884c\u4e3a\u65b9\u5411\u5bf9\u9f50\uff1b\u82e5\u6b63\u6837\u672c\u4ee3\u7801\u5b57\u95f4\u9694\u4f4e\u4e8e min_separation\uff0c\u5219\u65bd\u52a0\u6392\u65a5\u3002\u68af\u5ea6\u76f4\u63a5\u5230\u8fbe\u4e24\u7aef\u6700\u8fd1\u4ee3\u7801\u5b57\uff0c\u6545\u4e0e\u53ea\u8c03\u6574 encoder \u7684 residual transport \u4e0d\u540c\u3002\u76ee\u6807\u4e0d\u5305\u542b\u4f7f v \u53d8\u77ed\u7684\u9879\uff0c\u4e14\u663e\u5f0f\u60e9\u7f5a\u8fc7\u5c0f\u95f4\u9694\uff1b\u4e0d\u8fc7\u79bb\u6563\u6700\u8fd1\u90bb\u8fb9\u754c\u53ca\u591a\u4e2a\u884c\u4e3a\u5bf9\u7684\u53e0\u52a0\u4ecd\u53ef\u80fd\u6539\u53d8 cell \u5206\u914d\u3002",
