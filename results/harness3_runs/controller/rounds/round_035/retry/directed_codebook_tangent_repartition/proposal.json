  "differentiation": {
    "occupancy_preservation": "\u4ea4\u53c9\u71b5\u901a\u8fc7\u7801\u5b57\u76f8\u4f3c\u5ea6\u68af\u5ea6\u8c03\u6574\u8f6f\u5206\u914d\u8fb9\u754c\uff1b\u72ec\u7acb\u7684\u5168\u7801\u672c\u95f4\u9694\u60e9\u7f5a\u963b\u6b62\u7801\u5b57\u5f7c\u6b64\u9760\u8fd1\u3002\u95f4\u9694\u60e9\u7f5a\u5e76\u975e\u5bf9\u6bcf\u4e00\u884c\u4e3a\u5bf9\u7684\u786c SID \u7801\u5b57\u8ddd\u79bb\u4f5c\u4fdd\u8bc1\uff0c\u56e0\u6b64\u4e0d\u80fd\u5ba3\u79f0\u7edd\u5bf9\u7981\u6b62\u4efb\u4f55\u4e00\u5bf9\u7801\u5b57\u9760\u62e2\uff1b\u5176\u660e\u786e\u673a\u5236\u662f\u5bf9\u6240\u6709\u7801\u5b57\u5bf9\u65bd\u52a0\u4f4e\u95f4\u9694\u5c4f\u969c\uff0c\u4e14\u5fc5\u987b\u7531\u68c0\u67e5\u5668\u9a8c\u8bc1\u6709\u9650\u68af\u5ea6\u53ca\u5b9e\u9645\u5bfc\u51fa\u5206\u79bb\u5ea6\u3002",
