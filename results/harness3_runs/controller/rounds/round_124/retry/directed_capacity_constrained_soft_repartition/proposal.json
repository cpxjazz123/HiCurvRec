  "differentiation": {
    "occupancy_preservation": "\u5171\u4eab\u5206\u914d\u9879\u504f\u597d\u884c\u4e3a\u76f8\u5173\u7684\u8f6f\u5206\u533a\uff1b\u5bb9\u91cf\u60e9\u7f5a\u9650\u5236\u4efb\u4e00\u884c\u4e3a\u5bf9\u7684\u5171\u4eab\u8d23\u4efb\u76f8\u5bf9\u4e8e\u6765\u6e90\u53c2\u8003\u5206\u5e03\u7684\u96c6\u4e2d\u5ea6\u3002\u5b83\u4e0d\u4f7f\u7528\u628a\u4e24\u7aef\u7801\u5b57\u5750\u6807\u62c9\u5411\u5f7c\u6b64\u7684\u8ddd\u79bb\u635f\u5931\uff0c\u4e5f\u4e0d\u76f4\u63a5\u6700\u5c0f\u5316\u4e24\u7aef\u7801\u5b57\u8ddd\u79bb\uff1b\u7136\u800c\u5206\u914d\u91cd\u6392\u53ef\u80fd\u4f7f\u786c\u91cf\u5316\u540e\u4e24\u7aef\u843d\u5165\u540c\u4e00\u5355\u5143\uff0c\u56e0\u800c\u4e0d\u80fd\u4fdd\u8bc1\u914d\u5bf9\u7801\u5b57\u8ddd\u79bb\u4e0d\u4e0b\u964d\uff0c\u9700\u5728\u51b7\u5bfc\u51fa\u4e2d\u6838\u67e5\u3002",
    "vs_r8": [
      {
        "lane": "r8_01_directed_l1_transition_nce",
        "why": "\u4e0e encoder-only \u60e9\u7f5a\u4e0d\u540c\uff0c\u6b64\u9879\u5bf9 codebook \u6709\u660e\u786e\u68af\u5ea6\uff1b\u4e0e\u66fe\u9020\u6210\u7801\u5b57\u6536\u655b\u7684 pairwise \u4ea4\u53c9\u71b5\u4e0d\u540c\uff0c\u5b83\u4e0d\u4ee5\u4e24\u7aef\u7801\u5b57\u8ddd\u79bb\u53d8\u5c0f\u4e3a\u76ee\u6807\uff0c\u800c\u7528\u5171\u4eab\u8d23\u4efb\u5bb9\u91cf\u60e9\u7f5a\u9650\u5236\u5355\u5bf9\u884c\u4e3a\u4fe1\u53f7\u7684\u96c6\u4e2d\u3002\u4f46 assignment-level \u7684\u95f4\u63a5\u5408\u5e76\u98ce\u9669\u4ecd\u5b58\u5728\uff0c\u4e0d\u80fd\u628a\u8fd9\u4e00\u8bbe\u8ba1\u58f0\u660e\u5f53\u6210\u5b9e\u9645\u4e0d\u584c\u7f29\u7684\u8bc1\u636e\u3002"
      }
    ],
    "vs_reference_arm": "the reference arm is the untouched host; this candidate adds one term whose gradient reaches the codebook without pulling a transition's two codewords together"
  },
  "equation": "\u4ee4 p_i(k)=softmax_k(-||x_i-c_k||\u00b2/\u03c4)\u3002\u5bf9\u6bcf\u4e2a\u6709\u6548\u6709\u5411\u5bf9\uff0c\u5b9a\u4e49 a_st(k)=p_s(k)p_t(k)/(\u03b5+\u03a3_j p_s(j)p_t(j))\uff0cr_s(k)=p_s(k)/(\u03b5+\u03a3_j p_s(j))\u3002L=\u03bb mean[-log(\u03b5+\u03a3_k p_s(k)p_t(k)) + \u03b1\u03a3_k a_st(k)log((a_st(k)+\u03b5)/(r_s(k)+\u03b5)) + \u03b2\u03a3_k max(0, a_st(k)-\u03ba r_s(k))\u00b2]\u3002\u7a7a\u63a9\u7801\u65f6 L=0\u3002",
  "expected_failure_modes": [
